    # --- timer ---
    @staticmethod
    def _timer_next(m, up):
        m = m + 1 if up and m < 10 else m + 5 if up else m - 1 if m <= 10 else m - 5
        return max(1, min(TIMER_MAX, m))

    def timer_step(self, d):
        if self.timer_end:
            self.show_timer_left()
            return
        for _ in range(abs(d)):
            self.timer_minutes = self._timer_next(self.timer_minutes, d > 0)
        self.show_label(L("timer_set", m=self.timer_minutes), self.timer_minutes / TIMER_MAX)

    def timer_left(self):
        return max(0.0, self.timer_end - GLib.get_monotonic_time() / 1e6)

    def show_timer_left(self):
        left = int(self.timer_left() + 0.99)
        self.show_label(L("timer_left", mm=left // 60, ss=left % 60), self.timer_left() / (self.timer_minutes * 60))

    def timer_click(self):
        if self.timer_end:
            self.timer_cancel()
            self.show_label(L("timer_cancelled"))
            return
        self.timer_end = GLib.get_monotonic_time() / 1e6 + self.timer_minutes * 60
        self.timer_id = GLib.timeout_add(250, self.timer_tick)
        self.chip_win.play(self.draw_chip, 0, size=(210, 56), where="topright", fps=2)
        self.show_label(L("timer_started", m=self.timer_minutes))

    def timer_cancel(self):
        self.timer_end = 0.0
        if self.timer_id:
            GLib.source_remove(self.timer_id)
            self.timer_id = 0
        self.chip_win.stop()

    def timer_tick(self):
        if self.timer_left() > 0:
            return True
        self.timer_id = 0
        self.timer_cancel()
        self.ring()
        return False

    def draw_chip(self, cr, _t, w, h):
        left = int(self.timer_left() + 0.99)
        cr.set_source_rgba(0.08, 0.08, 0.1, 0.85)
        r = 20
        cr.new_sub_path()
        cr.arc(w - r, r, r, -math.pi / 2, 0)
        cr.arc(w - r, h - r, r, 0, math.pi / 2)
        cr.arc(r, h - r, r, math.pi / 2, math.pi)
        cr.arc(r, r, r, math.pi, 3 * math.pi / 2)
        cr.close_path()
        cr.fill()
        cr.set_source_rgba(1, 1, 1, 1)
        text(cr, f"⏲ {left // 60}:{left % 60:02d}", 18, w / 2, h / 2)

    def ring(self):
        self.tomato_win.play(make_tomato_draw(random.choice(TIMER_MESSAGES_L[_lang[0]])), TOMATO_S, fps=30, on_done=self.stop_alarm)
        cmd = f"while :; do paplay '{ALARM_SOUND}'; done" if os.path.exists(ALARM_SOUND) else "while :; do canberra-gtk-play -i alarm-clock-elapsed; done"
        self.alarm_proc = subprocess.Popen(["sh", "-c", cmd], start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def stop_alarm(self):
        self.tomato_win.stop()
        if self.alarm_proc:
            try:
                os.killpg(self.alarm_proc.pid, 15)
            except OSError:
                pass
            self.alarm_proc = None

    # --- video speed ---
    def mpris_rate(self, set_to=None):
        """Read (or set, then re-read) the playback rate of the first MPRIS player that supports it."""
        for name in self._mpris_players():
            iface = "org.mpris.MediaPlayer2.Player"
            try:
                if set_to is not None:
                    self.bus.call_sync(name, "/org/mpris/MediaPlayer2", "org.freedesktop.DBus.Properties", "Set",
                                       GLib.Variant("(ssv)", (iface, "Rate", GLib.Variant("d", set_to))),
                                       None, Gio.DBusCallFlags.NONE, 500, None)
                r = self.bus.call_sync(name, "/org/mpris/MediaPlayer2", "org.freedesktop.DBus.Properties", "Get",
                                       GLib.Variant("(ss)", (iface, "Rate")), None, Gio.DBusCallFlags.NONE, 500, None)
                rate = r.unpack()[0]
                if set_to is None or abs(rate - set_to) < 0.01:
                    return rate
            except GLib.Error:
                continue
        return None

    def set_speed(self, target):
        target = max(SPEED_MIN, min(SPEED_MAX, round(target / SPEED_STEP) * SPEED_STEP))
        rate = self.mpris_rate(target)
        if rate is not None:
            self.speed = rate
        elif self.in_browser():  # browsers that ignore MPRIS rate: use the player's < and > keys (0.25x..2x)
            target = min(target, 2.0)
            steps = round((target - self.speed) / SPEED_STEP)
            for _ in range(abs(steps)):
                self.ui.tap(KEY_DOT if steps > 0 else KEY_COMMA, shift=True)
            self.speed = target
        else:
            self.show_label(L("no_video_speed"))
            return
        self.show_label(L("speed", x=self.speed), (self.speed - SPEED_MIN) / (SPEED_MAX - SPEED_MIN))

    # --- night light ---
    def night_is_on(self):
        return os.path.exists(NIGHT_STATE)

    def night_toggle(self):
        if not self.desk.night_available():
            self.show_label(L("night_na"))
        elif self.night_is_on():
            self.night_off()
            self.show_label(L("night_off"))
        else:
            self.night_on()
            self.show_label(L("night_on", k=self.desk.night_temperature()))

    def night_on(self):
        if not self.night_is_on():  # remember the user's own schedule so it can be restored
            os.makedirs(os.path.dirname(NIGHT_STATE), exist_ok=True)
            with open(NIGHT_STATE, "w") as f:
                json.dump(self.desk.night_save(), f)
        self.desk.night_force_on()

    def night_off(self):
        try:
            with open(NIGHT_STATE) as f:
                saved = json.load(f)
        except (OSError, ValueError):
            saved = None
        self.desk.night_restore(saved)
        try:
            os.remove(NIGHT_STATE)
        except OSError:
            pass

    def night_step(self, d):
        if not self.desk.night_available():
            self.show_label(L("night_na"))
            return
        k = max(NIGHT_MIN, min(NIGHT_MAX, self.desk.night_temperature() - d * NIGHT_STEP))  # clockwise = warmer
        self.desk.set_night_temperature(k)
        if not self.night_is_on():
            self.night_on()
        self.show_label(L("night_k", k=k), (NIGHT_MAX - k) / (NIGHT_MAX - NIGHT_MIN))

    # --- window switcher (Alt held, Tab per step) ---
    def windows_step(self, d):
        if not self.alt_down:
            self.ui.emit((EV_KEY, KEY_LEFTALT, 1))
            self.alt_down = True
        for _ in range(abs(d)):
            self.ui.tap(KEY_TAB, shift=d < 0)
        if self.alt_id:
            GLib.source_remove(self.alt_id)
        self.alt_id = GLib.timeout_add(ALT_RELEASE_MS, self.release_alt)

    def release_alt(self):
        if self.alt_id:
            GLib.source_remove(self.alt_id)
            self.alt_id = 0
        if self.alt_down:
            self.ui.emit((EV_KEY, KEY_LEFTALT, 0))
            self.alt_down = False
        return False

    def windows_click(self):
        if self.alt_down:
            self.release_alt()  # confirm the highlighted window
            return
        self.ui.emit((EV_KEY, KEY_LEFTALT, 1))  # quick switch to the previous window
        self.ui.tap(KEY_TAB)
        self.ui.emit((EV_KEY, KEY_LEFTALT, 0))
        self.show_label(L("prev_window"))

    # --- API: everything the wheel can do, by name (the AI app calls it; one JSON line in, one JSON line out) ---
    def start_api(self):
        try:
            os.remove(API_SOCKET)
        except OSError:
            pass
        try:
            svc = Gio.SocketService()
            svc.add_address(Gio.UnixSocketAddress.new(API_SOCKET), Gio.SocketType.STREAM, Gio.SocketProtocol.DEFAULT, None)
            svc.connect("incoming", self.on_api_connection)
            svc.start()
            os.chmod(API_SOCKET, 0o600)
            self.api_service = svc
        except (GLib.Error, OSError) as e:
            print(f"asus-dial: no API socket ({e})", file=sys.stderr)

    def on_api_connection(self, _svc, conn, _src):
        try:
            conn.get_socket().set_timeout(2)
            raw = conn.get_input_stream().read_bytes(65536, None).get_data()
            reply = self.api(json.loads(raw.decode()))
            conn.get_output_stream().write_all(json.dumps(reply).encode() + b"\n", None)
            conn.close(None)
        except (GLib.Error, ValueError, OSError):
            pass
        return True

    def api(self, req):
        fn = getattr(self, "api_" + str(req.get("do", "")), None)
        if not fn:
            return {"ok": False, "error": "unknown action"}
        try:
            return {"ok": True, **(fn(req.get("args") or {}) or {})}
        except (ValueError, KeyError, TypeError, OSError, GLib.Error, subprocess.SubprocessError) as e:
            return {"ok": False, "error": f"{type(e).__name__}: {e}"}

    @staticmethod
    def _num(a, key, default=None):
        try:
            return float(a[key])
        except (KeyError, TypeError, ValueError):
            if default is None:
                raise ValueError(f"{key} is needed")
            return default

    def api_status(self, _a):
        v, muted = self.get_volume()
        return {"volume": round(v * 100), "muted": muted, "brightness": self.get_brightness(), "night_light": self.night_is_on(),
                "timer_left_s": round(self.timer_left()) if self.timer_end else 0, "dial_mode": acfg.BUILTIN_IDS[self.tool] if self.tool < CUSTOM_BASE else "custom",
                "screen_zoom": self.get_magnifier()}

    def api_volume(self, a):
        mode = a.get("mode", "set")
        sink = "@DEFAULT_AUDIO_SINK@"
        if mode in ("mute", "unmute", "toggle"):
            subprocess.run(["wpctl", "set-mute", sink, {"mute": "1", "unmute": "0", "toggle": "toggle"}[mode]])
        elif mode == "set":
            subprocess.run(["wpctl", "set-mute", sink, "0"])
            value = round(max(0, min(VOLUME_BOOST_MAX * 100, self._num(a, "value"))))
            if value > 100:
                self.volume_boost = True
            subprocess.run(["wpctl", "set-volume", "-l", self.volume_limit(), sink, f"{value}%"])
        elif mode == "boost":
            self.set_volume_boost(a.get("state", "on") != "off")
        else:
            step = round(abs(self._num(a, "value", 10)))
            subprocess.run(["wpctl", "set-volume", "-l", self.volume_limit(), sink, f"{step}%{'+' if mode == 'up' else '-'}"])
        self.show_volume()
        v, muted = self.get_volume()
        return {"volume": round(v * 100), "muted": muted}

    def api_brightness(self, a):
        mode, now = a.get("mode", "set"), self.get_brightness()
        step = abs(self._num(a, "value", 10))
        target = self._num(a, "value") if mode == "set" else now + (step if mode == "up" else -step)
        self.set_brightness(max(1, min(100, round(target))))
        self.show_brightness()
        return {"brightness": self.get_brightness(), "before": now}

    def api_zoom(self, a):
        """percent = the zoom wanted (100 = normal, 150 = one and a half times); or mode in / out / reset."""
        mode = a.get("mode", "set")
        browser = self.in_browser()
        if mode == "reset":
            percent = 100
        elif mode in ("in", "out"):
            percent = None
        else:
            percent = max(25, min(500 if browser else MAG_MAX * 100, self._num(a, "percent")))
        if browser:
            if percent is not None:
                near = min(BROWSER_ZOOMS, key=lambda z: abs(z - percent))
                self.ui.tap(KEY_0, ctrl=True)  # back to 100 %, then count the steps up or down
                steps = BROWSER_ZOOMS.index(near) - BROWSER_ZOOMS.index(100)
                label = near
            else:
                steps = 1 if mode == "in" else -1
                label = None
            for _ in range(abs(steps)):
                self.ui.emit((EV_KEY, KEY_LEFTCTRL, 1))
                self.ui.emit((EV_REL, REL_WHEEL, 1 if steps > 0 else -1))
                self.ui.emit((EV_KEY, KEY_LEFTCTRL, 0))
            self.show_label(f"🔍 Zoom {label}%" if label else "🔍 Zoom")
            return {"zoom": label, "where": "browser"}
        factor = percent / 100 if percent is not None else self.get_magnifier() + (MAG_STEP if mode == "in" else -MAG_STEP)
        f = self.set_magnifier(factor)
        self.show_label(L("screen_zoom", f=f), (f - 1) / (MAG_MAX - 1))
        return {"zoom": round(f * 100), "where": "screen"}

    def api_scroll(self, a):
        n = max(1, min(60, round(self._num(a, "amount", 5))))
        down = a.get("direction", "down") == "down"
        for _ in range(n):
            self.ui.emit((EV_REL, REL_WHEEL, -1 if down else 1))
        self.show_label(f"↕ {'▼' if down else '▲'} {n}")

    def api_media(self, a):
        act = a.get("action", "play_pause")
        if act in ("play", "pause", "play_pause"):
            if not self.mpris({"play": "Play", "pause": "Pause"}.get(act, "PlayPause")):
                self.ui.tap(KEY_PLAYPAUSE)
            self.show_label(L("play_pause"))
        elif act in ("next", "previous"):
            if not self.mpris("Next" if act == "next" else "Previous"):
                raise ValueError("no media player answered")
            self.show_label("⏭" if act == "next" else "⏮")
        elif act == "seek":
            sec = self._num(a, "seconds")
            if not self.mpris("Seek", GLib.Variant("(x)", (int(sec * 1_000_000),))):
                for _ in range(max(1, round(abs(sec) / 5))):
                    self.ui.tap(KEY_RIGHT if sec > 0 else KEY_LEFT)
            self.show_label(L("seek", icon="⏩" if sec > 0 else "⏪", n=abs(round(sec))))
        elif act == "speed":
            self.set_speed(self._num(a, "factor"))
        else:
            raise ValueError("unknown media action")
        return {}

    def api_tab(self, a):
        act = a.get("action", "next")
        if act in ("next", "previous"):
            self.ui.tap(KEY_PAGEDOWN if act == "next" else KEY_PAGEUP, ctrl=True)
            self.show_label(L("tab_next" if act == "next" else "tab_prev"))
        elif act == "new":
            self.ui.tap(KEY_T, ctrl=True)
            self.show_label("🗂 +")
        elif act == "close":
            self.ui.tap(KEY_W, ctrl=True)
            self.show_label("🗂 ✕")
        elif act == "reopen":
            self.ui.tap(KEY_T, ctrl=True, shift=True)
            self.show_label("🗂 ↺")
        else:
            raise ValueError("unknown tab action")

    def api_timer(self, a):
        if a.get("cancel"):
            self.timer_cancel()
            self.show_label(L("timer_cancelled"))
            return {}
        if self.timer_end:
            self.timer_cancel()
        self.timer_minutes = max(1, min(TIMER_MAX, round(self._num(a, "minutes"))))
        self.timer_click()
        return {"minutes": self.timer_minutes}

    def api_night_light(self, a):
        if not self.desk.night_available():
            raise ValueError("no night light")
        state = a.get("state", "toggle")
        if state == "toggle":
            state = "off" if self.night_is_on() else "on"
        if "kelvin" in a:
            self.desk.set_night_temperature(int(max(NIGHT_MIN, min(NIGHT_MAX, self._num(a, "kelvin")))))
        if state == "on":
            self.night_on()
        else:
            self.night_off()
        self.show_label(L("night_on", k=self.desk.night_temperature()) if state == "on" else L("night_off"))
        return {"night_light": state == "on"}

    def api_keyboard_light(self, a):
        level = a.get("level")
        if level is None:
            level = KEYLIGHT_LEVELS if a.get("state", "on") == "on" else 0
        self.set_keylight(round(float(level)))

    def api_windows(self, a):
        if a.get("action", "switch") == "switch":
            self.windows_click()
        else:
            self.windows_step(1 if a["action"] == "next" else -1)
            GLib.timeout_add(400, lambda: (self.release_alt(), False)[1])

    def api_find(self, a):
        act = a.get("action", "next")
        if act == "open":
            self.ui.tap(KEY_F, ctrl=True)
        else:
            self.ui.tap(KEY_F3, shift=act == "previous")
        self.show_label(L("find_open" if act == "open" else "find_next" if act == "next" else "find_prev"))

    def api_dice(self, a):
        sides = int(self._num(a, "sides", 6))
        result = random.randint(1, max(2, min(100, sides)))
        self.dice_win.play(make_dice_draw(sides if sides in DICE_SIDES else 6, result), DICE_SHOW_S, size=(420, 420))
        return {"result": result, "sides": sides}

    def api_language(self, a):
        code = a.get("lang", "")
        if code not in LANGS:
            raise ValueError("language must be one of " + ", ".join(LANGS))
        self.set_language(LANGS.index(code))

    def api_gpu(self, a):
        cards = agpu.gpus(refresh=True)
        want = a.get("which", "default")
        pick = {"integrated": next((g for g in cards if g["integrated"]), None), "dedicated": next((g for g in cards if not g["integrated"]), None),
                "default": cards[0] if cards else None}.get(want)
        if not pick or len(cards) < 2:
            raise ValueError("there is no such graphics card")
        self.gpu_idx = cards.index(pick)
        self.gpu_click()
        return {"gpu": pick["name"]}

    def api_power_profile(self, a):
        """state: power-saver | balanced | performance."""
        state = a.get("state", "")
        if state not in self.desk.power_profiles() or not self.desk.set_power_profile(state):
            raise ValueError("unknown or unavailable power profile")
        self.show_profile()
        return {"power_profile": state}

    def api_touchpad(self, a):
        """state: on | off | toggle."""
        on = self.desk.touchpad_enabled()
        if on is None:
            raise ValueError("no touchpad control")
        state = a.get("state", "toggle")
        want = (not on) if state == "toggle" else state == "on"
        if not self.desk.set_touchpad(want):
            raise ValueError("no touchpad control")
        self.show_touchpad()
        return {"touchpad": want}

    def api_suspend(self, _a):
        """Sleep, after the same 3 seconds as the wheel's mode (turning or clicking the wheel cancels it)."""
        self.start_power_countdown(SUSPEND_CMD, SUSPEND_COUNTDOWN_S, "suspend")

    def api_lock(self, _a):
        subprocess.run(["loginctl", "lock-session"], timeout=5)

    def api_mode(self, a):
        """Puts the wheel in one of its modes (volume, brightness, zoom, ...), as the radial menu does."""
        mid = a.get("name", "")
        if mid not in ID_TO_TOOL or mid in ("power", "rick", "suspend"):
            raise ValueError("unknown or not allowed mode")
        self.set_tool(ID_TO_TOOL[mid])
        self.save_tool()
        self.show_label(f"{ticon(self.tool)} {tname(self.tool)}")
        return {"dial_mode": mid}

    # --- OSD ---
    def show_label(self, label, value=None):
        o = self.osd
        o.label, o.value = label, value
        o.show_for("osd", 1200)

    def show_volume(self):
        v, muted = self.get_volume()
        top = VOLUME_BOOST_MAX if self.volume_boost else 1.0
        at_top = not self.volume_boost and v >= 1.0  # the end of the normal range: say how to go further
        self.show_label(f"{'🔇' if muted else '🔊'} {L('volume')} {round(v * 100)}%" + (L("boost") if self.volume_boost else "") +
                        (L("muted") if muted else "") + (L("boost_hint") if at_top else ""), min(1.0, v / top))

    def show_brightness(self):
        b = self.get_brightness()
        self.show_label(L("brightness", b=b), b / 100)


def main():
    p = argparse.ArgumentParser(description="ASUS Dial driver with on-screen menu")
    p.add_argument("--menu-step", type=float, default=8, help="dial units per menu item")
    p.add_argument("--invert", action="store_true", help="invert rotation direction")
    args = p.parse_args()
    load_lang()
    dial = Dial(args)
    GLib.timeout_add_seconds(1, dial.check_config)
    Gtk.main()


if __name__ == "__main__":
    main()
