class AnimWindow(Gtk.Window):
    """Transparent, click-through, always-on-top window that redraws a callback draw_fn(cr, t, w, h)."""

    def __init__(self):
        super().__init__(type=Gtk.WindowType.POPUP)
        self.set_app_paintable(True)
        self.set_visual(self.get_screen().get_rgba_visual())
        self.set_keep_above(True)
        self.set_decorated(False)
        self.set_skip_taskbar_hint(True)
        self.set_accept_focus(False)
        self.set_type_hint(Gdk.WindowTypeHint.NOTIFICATION)
        self.connect("draw", self._on_draw)
        self.connect("realize", lambda w: w.get_window().input_shape_combine_region(cairo.Region(), 0, 0))
        self.draw_fn = None
        self.t0 = 0.0
        self.duration = 0.0
        self.tick_id = 0
        self.on_done = None

    def play(self, draw_fn, duration_s, size=None, where="center", fps=60, on_done=None):
        """size None = whole monitor; duration_s 0 = until stop(); where: center | topright | full."""
        self.stop()
        display = self.get_screen().get_display()
        g = (display.get_primary_monitor() or display.get_monitor(0)).get_geometry()
        w, h = size or (g.width, g.height)
        x = g.x + (g.width - w) // 2
        y = g.y + (g.height - h) // 2
        if where == "topright":
            x, y = g.x + g.width - w - 24, g.y + 110
        self.resize(w, h)
        self.move(x, y)
        self.draw_fn, self.duration, self.on_done = draw_fn, duration_s, on_done
        self.t0 = GLib.get_monotonic_time() / 1e6
        self.show_all()
        self.queue_draw()
        self.tick_id = GLib.timeout_add(int(1000 / fps), self._tick)

    def _tick(self):
        if self.duration and GLib.get_monotonic_time() / 1e6 - self.t0 >= self.duration:
            self.tick_id = 0
            cb = self.on_done
            self.stop()
            if cb:
                cb()
            return False
        self.queue_draw()
        return True

    def stop(self):
        if self.tick_id:
            GLib.source_remove(self.tick_id)
            self.tick_id = 0
        self.draw_fn = self.on_done = None
        self.hide()

    def _on_draw(self, _w, cr):
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)
        if self.draw_fn:
            self.draw_fn(cr, GLib.get_monotonic_time() / 1e6 - self.t0, self.get_allocated_width(), self.get_allocated_height())


class Overlay(Gtk.Window):
    """Transparent, click-through, always-on-top window drawing menu or OSD."""

    on_menu_timeout = None

    def __init__(self, kind="menu"):
        super().__init__(type=Gtk.WindowType.POPUP)
        self.set_app_paintable(True)
        self.set_visual(self.get_screen().get_rgba_visual())
        self.set_keep_above(True)
        self.set_decorated(False)
        self.set_skip_taskbar_hint(True)
        self.set_accept_focus(False)
        self.set_type_hint(Gdk.WindowTypeHint.NOTIFICATION)
        self.connect("draw", self.on_draw)
        self.connect("realize", lambda w: w.get_window().input_shape_combine_region(cairo.Region(), 0, 0))
        self.kind = kind  # "menu" | "osd" | "image": every kind has its own window
        self.sel = 0  # index into items
        self.items = list(range(len(ICONS)))  # tool ids shown in the menu
        self.msize = MENU_SIZE
        self.label = ""
        self.value = None  # 0..1 or None
        self.hide_id = 0
        self.image = None  # GdkPixbuf shown by kind == "image"
        self.angle = 0.0
        self.theme = acfg.theme_of({})
        self.anim_cfg = acfg.animation_of({})
        self.backdrop = None  # blurred snapshot of the screen behind the window (frosted-glass theme)
        self.blur_rects = None  # what KWin is blurring behind the window (Plasma), see sync_blur
        self.frame_id = 0
        self.t0 = 0.0
        self.vis, self.vis_from, self.vis_t0, self.vis_dir, self.hiding = 0.0, 0.0, 0.0, 0, False  # appearance progress 0..1
        self.sel_from, self.sel_t0, self.sel_shown = None, 0.0, 0  # sliding highlight
        self.geom = (0, 0, 0, 0)  # size and place the window was last given

    def show_for(self, kind, timeout_ms):
        was_visible = self.get_visible()
        kind = self.kind
        th, an = self.theme, self.anim_cfg
        if kind == "menu":
            pad = ath.menu_pad(th)
            w = h = self.msize + 2 * pad
        elif kind == "image":
            w = h = int(math.hypot(self.image.get_width(), self.image.get_height())) + 20
        else:
            pad = ath.osd_pad(th)
            w, h = ath.OSD_W + 2 * pad, ath.OSD_H + 2 * pad
        display = self.get_screen().get_display()
        mon = display.get_primary_monitor() or display.get_monitor(0)
        g = mon.get_geometry()
        x = g.x + (g.width - w) // 2
        if kind == "osd":
            y = g.y + g.height - ath.OSD_H - 120 - pad
        else:
            y = g.y + (g.height - h) // 2
        remapped = False
        if was_visible and (w, h, x, y) != self.geom:
            # A mapped window that changes size AND place can show the new size at the old place for a few frames
            # (a half menu below the screen): unmap it, so it appears already in the right place.
            Gtk.Window.hide(self)
            was_visible, remapped = False, True
            self.hiding, self.vis_dir = False, 0
        self.geom = (w, h, x, y)
        self.resize(w, h)
        self.move(x, y)
        if not self.get_realized():
            self.realize()
        if not self.get_mapped():
            self.get_window().move_resize(x, y, w, h)  # already in place when it is mapped, never at 0, 0 first
        now = GLib.get_monotonic_time() / 1e6
        if not was_visible:
            self.t0 = now
            # frosted glass: blur what is behind the window, taken just before it appears
            can_blur = kind in ("menu", "osd") and th["blur"] > 0 and not remapped and adesk.kwin_blur() is None
            self.backdrop = ath.capture_backdrop(x, y, w, h, th["blur"]) if can_blur else None
        # the highlight slides from the old slice to the new one
        if kind == "menu":
            n = len(self.items)
            if not was_visible or n < 2:
                self.sel_from = None
            elif self.sel != self.sel_shown and an["highlight"] and an["highlight_ms"] > 0:
                self.sel_from, self.sel_t0 = self.sel_pos(now), now
            self.sel_shown = self.sel
        # appearing: from where it is now (0 when it was hidden) up to 1
        animated = kind in ("menu", "osd") and an["in_type"] != "none" and an["in_ms"] > 0
        if not was_visible:
            self.vis = 0.0 if animated else 1.0
        if self.hiding or self.vis < 1.0:
            if animated:
                self.vis_from, self.vis_t0, self.vis_dir = self.vis, now, 1
            else:
                self.vis, self.vis_dir = 1.0, 0
        self.hiding = False
        self.show_all()
        self.queue_draw()
        self._ensure_frames()
        if self.hide_id:
            GLib.source_remove(self.hide_id)
        self.hide_id = GLib.timeout_add(timeout_ms, self._timeout)

    # --- smooth appearance / disappearance and the sliding highlight
    def sel_pos(self, now):
        """Where the highlight is right now (a float slice index while it slides)."""
        an = self.anim_cfg
        if self.sel_from is None:
            return float(self.sel)
        u = (now - self.sel_t0) / max(0.001, an["highlight_ms"] / 1000)
        if u >= 1.0:
            self.sel_from = None
            return float(self.sel)
        return ath.sel_interp(self.sel_from, self.sel, max(1, len(self.items)), u, an["ease"])

    def _ensure_frames(self):
        now = GLib.get_monotonic_time() / 1e6
        rainbow_label = self.kind == "osd" and isinstance(self.label, list) and any(c == "rainbow" for _s, c in self.label)
        busy = self.vis_dir != 0 or self.sel_from is not None or rainbow_label or (self.kind in ("menu", "osd") and ath.is_animated(self.theme))
        if busy and not self.frame_id and self.get_visible():
            self.frame_id = GLib.timeout_add(16, self._frame)

    def _frame(self):
        if not self.get_visible():
            self.frame_id = 0
            return False
        now = GLib.get_monotonic_time() / 1e6
        an = self.anim_cfg
        if self.vis_dir != 0:
            dur = max(0.001, (an["in_ms"] if self.vis_dir > 0 else an["out_ms"]) / 1000)
            p = self.vis_from + self.vis_dir * (now - self.vis_t0) / dur
            if self.vis_dir > 0 and p >= 1.0:
                p, self.vis_dir = 1.0, 0
            elif self.vis_dir < 0 and p <= 0.0:
                self.frame_id = 0
                self._really_hide()
                return False
            self.vis = p
        self.queue_draw()
        if self.vis_dir == 0 and self.sel_from is None and not (self.kind in ("menu", "osd") and ath.is_animated(self.theme)):
            self.frame_id = 0
            return False
        return True

    def begin_hide(self):
        """Go away: with the 'out' animation if there is one, at once otherwise."""
        if not self.get_visible() or self.hiding:
            return
        an = self.anim_cfg
        if self.kind not in ("menu", "osd") or an["out_type"] == "none" or an["out_ms"] <= 0:
            self._really_hide()
            return
        self.hiding = True
        self.vis_from, self.vis_t0, self.vis_dir = self.vis, GLib.get_monotonic_time() / 1e6, -1
        self._ensure_frames()

    def _really_hide(self):
        self.hiding = False
        self.vis_dir = 0
        self.vis = 0.0
        self.hide()

    def _timeout(self):
        self.hide_id = 0
        was_menu = self.kind == "menu"
        self.begin_hide()
        if was_menu and self.on_menu_timeout:
            self.on_menu_timeout()
        return False

    def close_overlay(self):
        if self.hide_id:
            GLib.source_remove(self.hide_id)
            self.hide_id = 0
        self.begin_hide()

    def on_draw(self, _w, cr):
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)
        now = GLib.get_monotonic_time() / 1e6
        t = now - self.t0
        an = self.anim_cfg
        anim = None
        if self.kind in ("menu", "osd") and self.vis < 1.0:
            anim = (an["out_type"] if self.hiding else an["in_type"], self.vis, an["ease"])
        if self.kind == "menu":
            items = [(ticon(i), tname(i)) for i in self.items]
            sel = min(self.sel, len(items) - 1)
            ath.draw_menu(cr, self.theme, items, sel, t, self.msize, self.backdrop, sel_pos=self.sel_pos(now), anim=anim)
        elif self.kind == "image":
            self.draw_image(cr)
        else:
            ath.draw_osd(cr, self.theme, self.label, self.value, t, self.backdrop, anim=anim)
        self.sync_blur(anim)

    def sync_blur(self, anim):
        """On Plasma KWin itself blurs what is behind the menu or the message (real frosted glass), in their shape,
        following them while they zoom or slide in and out."""
        kb = adesk.kwin_blur()
        if kb is None or not isinstance(self.get_window(), GdkX11.X11Window):
            return
        shape = ath.blur_shape(self.kind, self.theme, self.msize, anim)
        rects = ath.shape_rects(shape, self.get_scale_factor()) if shape else None
        if rects != self.blur_rects:
            self.blur_rects = rects
            kb.set(self.get_window().get_xid(), rects)

    def draw_image(self, cr):
        iw, ih = self.image.get_width(), self.image.get_height()
        cr.translate(self.get_allocated_width() / 2, self.get_allocated_height() / 2)
        cr.rotate(math.radians(self.angle))
        cr.translate(-iw / 2, -ih / 2)
        cr.rectangle(-6, -6, iw + 12, ih + 12)  # white frame
        cr.set_source_rgb(1, 1, 1)
        cr.fill()
        Gdk.cairo_set_source_pixbuf(cr, self.image, 0, 0)
        cr.paint()


class Dial:
    # dial units needed per step of each tool; one physical detent is ~8-10 units
    STEP = {SCROLL: 6, VOLUME: 8, BRIGHT: 8, ZOOM: 8, VIDEO: 8, TABS: 8, ARROWS: 8,
            DICE: 8, TIMER: 8, SPEED: 8, NIGHT: 8, WINDOWS: 8, FIND: 8, KEYLIGHT: 8, LANGUAGE: 8, RICK: 8, AI: 8, GPU: 8, SUSPEND: 8, PROFILE: 16, TOUCHPAD: 8}

    def __init__(self, args):
        self.args = args
        self.sign = 1 if args.invert else -1  # default: clockwise = scroll down / more
        self.ui = Uinput()
        self.overlay = Overlay("menu")
        self.osd = Overlay("osd")
        self.house_win = Overlay("image")
        self.overlay.on_menu_timeout = lambda: setattr(self, "menu_open", False)
        self.cfg, self.cfg_mtime, self.lang_mtime = acfg.load(), acfg.config_mtime(), self._mtime(LANG_FILE)
        self.menu_tools = []
        self.cur_custom_id = None
        self.apply_config()
        self.tool = self.load_tool()
        self.menu_open = False
        self.acc = 0.0
        self.wheel_acc = 0.0
        self.detent_acc = 0
        self.last_rot = 0.0
        self.last_btn = 0
        self.power_seen = 0.0
        self.power_started = 0.0
        self.hold_id = 0
        self.power_progress = 0.0
        self.power_left = 0
        self.power_id = 0
        self.power_cmd, self.power_total, self.power_key = POWER_CMD, POWER_COUNTDOWN_S, "power"
        self.press_travel = 0
        self.hold_fired = False
        self.hold_moved = False
        self.swallow_release = False
        self.bus = Gio.bus_get_sync(Gio.BusType.SESSION)
        self.focus_checked = -1.0
        self.rick_busy = False
        self.ai_busy = False
        self.ai_level = self.load_ai_level()
        self.robot_win = AnimWindow()
        self.divine_win = AnimWindow()
        self.dice_win, self.tomato_win, self.chip_win = AnimWindow(), AnimWindow(), AnimWindow()
        self.dice_idx = DICE_SIDES.index(6)
        self.browser_proc_checked, self.browser_proc = 0.0, False  # is a browser process running (see _browser_running)
        self.report_id, self.report_seen = None, 0.0  # which HID report kind the dial is using
        self.gpu_idx = None  # card picked with the wheel in the GPU mode (None = the one in use)
        self.timer_minutes, self.timer_end, self.timer_id = 5, 0.0, 0
        self.alarm_proc = None
        self.speed = 1.0
        self.keylight_last = KEYLIGHT_LEVELS
        self.volume_click_id = 0
        self.volume_boost = self.get_volume()[0] > 1.0  # the volume survives a restart, and so does a boost
        self.alt_down, self.alt_id = False, 0
        self.desk = adesk.for_session(self.bus)
        self.focus_browser = False
        self.watch_id = 0
        self.connect_hid()
        self.start_api()

    # --- config file (written by asus-dial-manager; reloaded by itself when it changes) ---
    @staticmethod
    def _mtime(path):
        try:
            return os.stat(path).st_mtime_ns
        except OSError:
            return 0

    def apply_config(self):
        self.sens = acfg.sensitivity(self.cfg)
        _custom[:] = self.cfg["custom"]
        ids = [c["id"] for c in _custom]
        tools = []
        for mode_id in acfg.mode_order(self.cfg):
            if mode_id.startswith("custom:"):
                if mode_id[7:] in ids:
                    tools.append(CUSTOM_BASE + ids.index(mode_id[7:]))
            else:
                tools.append(ID_TO_TOOL[mode_id])
        self.menu_tools = tools or [SCROLL]
        for win in (self.overlay, self.osd):
            win.theme = acfg.theme_of(self.cfg)
            win.anim_cfg = acfg.animation_of(self.cfg)
        if getattr(self, "tool", SCROLL) >= CUSTOM_BASE:  # the custom list may have changed: find the mode again
            cid = self.cur_custom_id
            self.tool = CUSTOM_BASE + ids.index(cid) if cid in ids else SCROLL

    def check_config(self):
        mt = acfg.config_mtime()
        if mt != self.cfg_mtime:
            self.cfg_mtime = mt
            self.cfg = acfg.load()
            self.apply_config()
        lm = self._mtime(LANG_FILE)
        if lm != self.lang_mtime:
            self.lang_mtime = lm
            load_lang()
        return True

    def set_tool(self, tool):
        self.tool = tool
        self.cur_custom_id = _custom[tool - CUSTOM_BASE]["id"] if CUSTOM_BASE <= tool < CUSTOM_BASE + len(_custom) else None

    def run_custom(self, tool, action, n):
        """Send the key sequence of a custom mode (click / cw / ccw), n times."""
        if tool - CUSTOM_BASE >= len(_custom):
            return
        mode = _custom[tool - CUSTOM_BASE]
        try:
            seq = acfg.parse_sequence(mode[action]) * n
        except ValueError:
            self.show_label(f"{mode['icon']} {mode['name']}  ⚠")
            return
        for i, (mods, key) in enumerate(seq):
            GLib.timeout_add(25 * i, lambda m=mods, k=key: (self.ui.combo(m, k), False)[1])
        self.show_label(f"{mode['icon']} {mode['name']}")

    # --- persistence ---
    def load_tool(self):
        try:
            raw = open(STATE_FILE).read().strip()
        except OSError:
            return SCROLL
        if raw.startswith("c:"):
            ids = [c["id"] for c in _custom]
            if raw[2:] in ids:
                self.cur_custom_id = raw[2:]
                return CUSTOM_BASE + ids.index(raw[2:])
            return SCROLL
        try:
            return int(raw) % len(ICONS)
        except ValueError:
            return SCROLL

    def save_tool(self):
        try:
            os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
            with open(STATE_FILE, "w") as f:
                f.write(f"c:{self.cur_custom_id}" if self.tool >= CUSTOM_BASE else str(self.tool))
        except OSError:
            pass

    # --- hid plumbing ---
    def connect_hid(self):
        path = find_hidraw()
        if path is None:
            GLib.timeout_add_seconds(2, self.connect_hid)
            return False
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
        self.watch_id = GLib.io_add_watch(fd, GLib.IO_IN | GLib.IO_ERR | GLib.IO_HUP, self.on_hid)
        return False

    def on_hid(self, fd, cond):
        if not cond & GLib.IO_IN:
            return self.hid_lost(fd)
        try:
            while True:
                data = os.read(fd, 64)
                if len(data) >= 4 and data[0] in DIAL_REPORT_IDS and self.accept_report_id(data[0]):
                    self.on_report(data[1] & 1, struct.unpack_from("<h", data, 2)[0])
        except BlockingIOError:
            return True
        except OSError:
            return self.hid_lost(fd)

    def accept_report_id(self, rid):
        """The dial sends its state as report 0x01 (standard) or as report 0x0a (vendor), same layout; which of the two depends on
        the state it came up in. Follow the one that is talking and ignore the other, so a dial that sent both would not count twice."""
        now = GLib.get_monotonic_time() / 1e6
        if rid != self.report_id and now - self.report_seen > 2.0:  # the other kind went quiet (or never spoke): switch
            self.report_id = rid
        self.report_seen = now if rid == self.report_id else self.report_seen
        return rid == self.report_id

    def hid_lost(self, fd):
        self.report_id = None
        os.close(fd)
        GLib.timeout_add_seconds(2, self.connect_hid)
        return False

    # --- button / hold handling ---
    def on_report(self, btn, delta):
        if delta:
            self.rotate(delta)
        if btn == self.last_btn:
            return
        self.last_btn = btn
        if btn:
            self.button_down()
        else:
            self.button_up()

    def button_down(self):
        self.hold_fired = False
        self.hold_moved = False
        self.swallow_release = False
        self.acc = 0.0
        self.press_travel = 0
        if self.alarm_proc or self.tomato_win.tick_id:  # any press silences the timer alarm
            self.stop_alarm()
            self.swallow_release = True
            return
        if self.power_id:
            self.cancel_power()
            self.swallow_release = True
            return
        if self.menu_open:  # click while the menu is open confirms the highlighted tool
            self.confirm_menu()
            self.swallow_release = True
            return
        if self.volume_click_id:  # second press right after a click in Volume mode: the boost, at once
            GLib.source_remove(self.volume_click_id)
            self.volume_click_id = 0
            self.swallow_release = True
            self.set_volume_boost(not self.volume_boost)
            return
        self.hold_id = GLib.timeout_add(HOLD_MS, self.hold_timeout)

    def hold_timeout(self):
        self.hold_id = 0
        self.hold_fired = True
        self.open_menu()
        return False

    def button_up(self):
        if self.swallow_release:
            self.swallow_release = False
            self.hold_fired = False
            return
        if self.hold_id:  # released before the hold threshold: short click
            GLib.source_remove(self.hold_id)
            self.hold_id = 0
            self.click()
        elif self.hold_fired and self.menu_open and self.hold_moved:
            self.confirm_menu()  # hold, rotate, release
        self.hold_fired = False

    def open_menu(self):
        self.release_alt()
        self.menu_open = True
        self.acc = 0.0
        self.overlay.items = self.available_tools()
        self.overlay.msize = MENU_SIZE + max(0, len(self.overlay.items) - 19) * 20
        tool = self.effective_tool()
        self.overlay.sel = self.overlay.items.index(tool) if tool in self.overlay.items else 0
        self.overlay.show_for("menu", MENU_TIMEOUT_MS)

    def confirm_menu(self):
        self.menu_open = False
        self.acc = 0.0
        self.set_tool(self.overlay.items[self.overlay.sel])
        self.power_progress = 0.0
        self.save_tool()
        self.overlay.close_overlay()
        self.show_label(f"{ticon(self.tool)} {tname(self.tool)}")

    # --- rotation ---
    def step_units(self, tool):
        """Dial units of turning for one step of the tool: fewer with a higher sensitivity."""
        return self.STEP.get(tool, 8) / self.sens

    def rotate(self, delta):
        now = GLib.get_monotonic_time() / 1e6
        if now - self.last_rot > 0.7:  # drop leftover partial steps after a pause
            self.acc = self.wheel_acc = 0.0
        self.last_rot = now
        if self.power_id:  # rotation cancels a running countdown, after a grace period for the arming swing
            if now - self.power_started > POWER_GRACE_S:
                self.cancel_power()
            return
        if self.menu_open:
            self.acc += delta
            menu_step = self.args.menu_step / self.sens ** 0.6  # the menu follows the sensitivity more gently, so a detent does not skip items
            steps = int(self.acc / menu_step)
            if steps:
                self.acc -= steps * menu_step
                self.overlay.sel = (self.overlay.sel - steps * self.sign) % len(self.overlay.items)
                self.hold_moved = self.hold_moved or bool(self.last_btn)
                self.overlay.show_for("menu", MENU_TIMEOUT_MS)
            return
        if self.last_btn and self.hold_id:  # press + rotate opens the menu (a tiny wobble must not)
            self.press_travel += abs(delta)
            if self.press_travel >= PRESS_ROTATE_UNITS:
                GLib.source_remove(self.hold_id)
                self.hold_id = 0
                self.hold_fired = True
                self.open_menu()
                self.hold_moved = True
            return
        tool = self.effective_tool()
        if tool == ZOOM and not self.in_browser():
            self.rotate_magnifier(delta)  # outside the browser: real screen zoom
            return
        if tool in (SCROLL, ZOOM):
            self.rotate_wheel(delta, tool)
            return
        if tool == HOUSE:
            self.show_house(delta)
            return
        if tool == POWER:
            self.rotate_power(delta, now)
            return
        self.acc += delta
        step = self.step_units(tool)
        steps = int(self.acc / step)
        if steps:
            self.acc -= steps * step
            self.step_tool(tool, -self.sign * steps)  # >0 = clockwise (by default)

    def rotate_wheel(self, delta, tool):
        zoom = tool == ZOOM
        self.wheel_acc += delta * (-self.sign if zoom else self.sign) * 120 / self.step_units(tool)
        whole = int(self.wheel_acc)
        if not whole:
            return
        self.wheel_acc -= whole
        if zoom:
            self.ui.emit((EV_KEY, KEY_LEFTCTRL, 1))
        events = [(EV_REL, REL_WHEEL_HI_RES, whole)]
        self.detent_acc += whole
        ticks = int(self.detent_acc / 120)
        if ticks:
            self.detent_acc -= ticks * 120
            events.append((EV_REL, REL_WHEEL, ticks))
        self.ui.emit(*events)
        if zoom:
            self.ui.emit((EV_KEY, KEY_LEFTCTRL, 0))
        self.show_label(f"{ticon(tool)} {tname(tool)}")

    def step_tool(self, tool, d):
        n = abs(d)
        if tool >= CUSTOM_BASE:
            self.run_custom(tool, "cw" if d > 0 else "ccw", n)
        elif tool == VOLUME:
            subprocess.run(["wpctl", "set-volume", "-l", self.volume_limit(), "@DEFAULT_AUDIO_SINK@", f"{2 * n}%{'+' if d > 0 else '-'}"])
            self.show_volume()
        elif tool == BRIGHT:
            self.set_brightness(max(1, min(100, self.get_brightness() + (2 * n if d > 0 else -2 * n))))
            self.show_brightness()
        elif tool == VIDEO:
            if not self.mpris("Seek", GLib.Variant("(x)", (5_000_000 * d,))):
                for _ in range(n):
                    self.ui.tap(KEY_RIGHT if d > 0 else KEY_LEFT)
            self.show_label(L("seek", icon="⏩" if d > 0 else "⏪", n=5 * n))
        elif tool == TABS:
            for _ in range(n):
                self.ui.tap(KEY_PAGEDOWN if d > 0 else KEY_PAGEUP, ctrl=True)
            self.show_label(L("tab_next" if d > 0 else "tab_prev"))
        elif tool == ARROWS:
            for _ in range(n):
                self.ui.tap(KEY_RIGHT if d > 0 else KEY_LEFT)
            self.show_label(f"↔ {'→' if d > 0 else '←'}")
        elif tool == DICE:
            self.dice_idx = max(0, min(len(DICE_SIDES) - 1, self.dice_idx + d))
            self.show_label(L("dice_pick", n=DICE_SIDES[self.dice_idx]), self.dice_idx / (len(DICE_SIDES) - 1))
        elif tool == TIMER:
            self.timer_step(d)
        elif tool == SPEED:
            self.set_speed(self.speed + d * SPEED_STEP)
        elif tool == NIGHT:
            self.night_step(d)
        elif tool == WINDOWS:
            self.windows_step(d)
        elif tool == KEYLIGHT:
            self.set_keylight(self.get_keylight() + d)
        elif tool == LANGUAGE:
            self.set_language((LANGS.index(_lang[0]) + d) % len(LANGS))
        elif tool == RICK:
            self.show_label(L("rick_hint"))
        elif tool == GPU:
            self.gpu_step(d)
        elif tool == SUSPEND:
            self.show_label(L("suspend_hint"))
        elif tool == PROFILE:
            self.profile_step(d)
        elif tool == TOUCHPAD:
            self.show_touchpad()
        elif tool == AI:
            self.ai_level = max(0, min(len(AI_LEVELS) - 1, self.ai_level + d))
            self.save_ai_level()
            self.show_ai_label()
            ai_tell_app("model " + AI_LEVELS[self.ai_level][0])  # the AI app, if open, switches model with the wheel
        elif tool == FIND:
            for _ in range(n):
                self.ui.tap(KEY_F3, shift=d < 0)
            self.show_label(L("find_next" if d > 0 else "find_prev"))

    # --- short click action per tool ---
    def click(self):
        tool = self.effective_tool()
        if tool >= CUSTOM_BASE:
            self.run_custom(tool, "click", 1)
        elif tool == SCROLL:
            self.ui.tap(BTN_MIDDLE)
            self.show_label(L("middle_click"))
        elif tool == VOLUME:
            self.volume_click()
        elif tool == ZOOM:
            if self.in_browser():
                self.ui.tap(KEY_0, ctrl=True)
            else:
                self.set_magnifier(1.0)
            self.show_label("🔍 Zoom 100%")
        elif tool == VIDEO:
            if not self.mpris("PlayPause"):
                self.ui.tap(KEY_PLAYPAUSE)
            self.show_label(L("play_pause"))
        elif tool == POWER:
            self.power_progress = 0.0
            self.show_label(L("power_hint"), 0.0)
        elif tool == ARROWS:
            self.ui.tap(KEY_ENTER)
            self.show_label(L("enter"))
        elif tool == DICE:
            self.roll_dice()
        elif tool == TIMER:
            self.timer_click()
        elif tool == SPEED:
            self.set_speed(1.0)
        elif tool == NIGHT:
            self.night_toggle()
        elif tool == WINDOWS:
            self.windows_click()
        elif tool == LANGUAGE:
            self.set_language(LANGS.index(_lang[0]))
        elif tool == RICK:
            self.rick_start()
        elif tool == AI:
            self.ai_start()
        elif tool == GPU:
            self.gpu_click()
        elif tool == SUSPEND:
            self.start_power_countdown(SUSPEND_CMD, SUSPEND_COUNTDOWN_S, "suspend")
        elif tool == PROFILE:
            self.profile_step(1, wrap=True)
        elif tool == TOUCHPAD:
            self.touchpad_toggle()
        elif tool == KEYLIGHT:
            self.keylight_last = self.keylight_last if self.get_keylight() == 0 else self.get_keylight()
            self.set_keylight(self.keylight_last if self.get_keylight() == 0 else 0)
        elif tool == FIND:
            self.ui.tap(KEY_F, ctrl=True)
            self.show_label(L("find_open"))
        else:
            self.show_label(f"{ticon(tool)} {tname(tool)}  {L('hold_hint')}")

    # --- context: which tools make sense right now ---
    def in_browser(self):
        """True if the focused window is a web browser (cached for a moment)."""
        now = GLib.get_monotonic_time() / 1e6
        if now - self.focus_checked > FOCUS_CACHE_S:
            self.focus_checked = now
            self.focus_browser = self._focus_is_browser()
        return self.focus_browser

    def _focus_is_browser(self):
        cls = self.desk.focus_class()
        if cls is not None:  # the desktop tells which window has the focus (any window on KDE, X11 ones on GNOME)
            return any(b in cls for b in BROWSER_CLASSES)
        # A native Wayland window on GNOME has the focus (GNOME does not tell which one, to anybody).
        # Then a running browser is the best guess, so the browser modes (Tabs, Find) and the page zoom stay available.
        return self._browser_running()

    def _browser_running(self):
        """True if a web browser process exists (looked up at most every 2 seconds)."""
        now = GLib.get_monotonic_time() / 1e6
        if now - self.browser_proc_checked > 2.0:
            self.browser_proc_checked = now
            found = False
            for comm in glob.glob("/proc/[0-9]*/comm"):
                try:
                    with open(comm) as f:
                        name = f.read().strip().lower()
                except OSError:
                    continue
                if any(b in name for b in BROWSER_PROCS) and not any(x in name for x in ("crashpad", "handler", "sandbox", "updater")):
                    found = True
                    break
            self.browser_proc = found
        return self.browser_proc

    def available_tools(self):
        browser = self.in_browser()
        return [t for t in self.menu_tools if browser or t not in BROWSER_ONLY] or [SCROLL]

    def effective_tool(self):
        """The chosen tool, or Scroll while a browser-only tool has no browser to act on (choice is kept)."""
        return self.tool if self.tool in self.available_tools() else SCROLL

    # --- real screen zoom outside the browser (GNOME magnifier / KWin Zoom effect) ---
    def get_magnifier(self):
        return self.desk.get_magnifier()

    def set_magnifier(self, factor):
        return self.desk.set_magnifier(factor, MAG_STEP, MAG_MAX)

    def rotate_magnifier(self, delta):
        self.acc += delta * -self.sign  # clockwise (default) = zoom in
        step = self.step_units(ZOOM)
        steps = int(self.acc / step)
        if not steps:
            return
        self.acc -= steps * step
        f = self.set_magnifier(self.get_magnifier() + steps * MAG_STEP)
        self.show_label(L("screen_zoom", f=f), (f - 1) / (MAG_MAX - 1))

    # --- system helpers ---
    def _mpris_players(self):
        """MPRIS player bus names, the ones that are playing first."""
        try:
            names = self.bus.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
                                       "ListNames", None, GLib.VariantType("(as)"), Gio.DBusCallFlags.NONE, 500, None).unpack()[0]
        except GLib.Error:
            return []
        players = [n for n in names if n.startswith("org.mpris.MediaPlayer2.")]

        def playing(name):
            try:
                r = self.bus.call_sync(name, "/org/mpris/MediaPlayer2", "org.freedesktop.DBus.Properties", "Get",
                                       GLib.Variant("(ss)", ("org.mpris.MediaPlayer2.Player", "PlaybackStatus")),
                                       None, Gio.DBusCallFlags.NONE, 500, None)
                return r.unpack()[0] == "Playing"
            except GLib.Error:
                return False

        return sorted(players, key=lambda n: not playing(n))

    def mpris(self, method, params=None):
        """Call a method on the most relevant MPRIS player (playing first). True if one answered."""
        for name in self._mpris_players():
            try:
                self.bus.call_sync(name, "/org/mpris/MediaPlayer2", "org.mpris.MediaPlayer2.Player", method,
                                   params, None, Gio.DBusCallFlags.NONE, 500, None)
                return True
            except GLib.Error:
                continue
        return False

    # Volume boost: lets the wheel take the sound above 100%, up to VOLUME_BOOST_MAX (a quick double click in Volume mode).
    def volume_limit(self):
        return str(VOLUME_BOOST_MAX) if self.volume_boost else "1.0"

    def volume_click(self):
        """One click mutes, but it waits a moment: a second press right after it switches the boost instead (see button_down)."""
        self.volume_click_id = GLib.timeout_add(VOLUME_DOUBLE_CLICK_MS, self.volume_single_click)

    def volume_single_click(self):
        self.volume_click_id = 0
        subprocess.run(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "toggle"])
        self.show_volume()
        return False

    def set_volume_boost(self, on):
        """Only moves the limit, the volume stays where it is (off: above 100% it comes back to 100%)."""
        self.volume_boost = on
        if not on and self.get_volume()[0] > 1.0:
            subprocess.run(["wpctl", "set-volume", "-l", "1.0", "@DEFAULT_AUDIO_SINK@", "100%"])
        self.show_label(L("boost_on" if on else "boost_off"))

    def get_volume(self):
        try:
            out = subprocess.run(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"], capture_output=True, text=True).stdout
            return float(out.split()[1]), "[MUTED]" in out
        except (IndexError, ValueError, OSError):
            return 0.0, False

    def get_brightness(self):
        b = self.desk.get_brightness()
        return 50 if b is None else b

    def set_brightness(self, pct):
        self.desk.set_brightness(max(0, min(100, pct)))

    # --- shutdown ---
    def rotate_power(self, delta, now):
        if now - self.power_seen > 3:  # stale progress after a pause
            self.power_progress = 0.0
        self.power_seen = now
        self.power_progress = max(0.0, min(float(POWER_ARM_UNITS), self.power_progress - self.sign * delta))
        if self.power_progress >= POWER_ARM_UNITS:
            self.start_power_countdown()
        else:
            self.show_label(L("power_rotate"), self.power_progress / POWER_ARM_UNITS)

    def start_power_countdown(self, cmd=POWER_CMD, seconds=POWER_COUNTDOWN_S, key="power"):
        self.power_cmd, self.power_total, self.power_key = cmd, seconds, key
        self.power_left = seconds
        self.power_started = GLib.get_monotonic_time() / 1e6
        self.power_progress = 0.0
        self.power_tick()
        self.power_id = GLib.timeout_add(1000, self.power_tick)

    def power_tick(self):
        if self.power_left <= 0:
            self.power_id = 0
            subprocess.Popen(self.power_cmd)
            return False
        self.show_label(L(self.power_key + "_count", n=self.power_left), self.power_left / self.power_total)
        self.power_left -= 1
        return True

    def cancel_power(self):
        if self.power_id:
            GLib.source_remove(self.power_id)
            self.power_id = 0
        self.power_progress = 0.0
        self.show_label(L(self.power_key + "_cancel"))

    # --- house picture ---
    def show_house(self, delta):
