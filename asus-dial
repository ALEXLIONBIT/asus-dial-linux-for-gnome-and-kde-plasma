        save_lang()
        self.show_label(L("language", name=LANG_NAMES[_lang[0]]), idx / (len(LANGS) - 1))

    # --- GPU: rotate to pick a graphics card, click to make the apps use it (see asus_dial_gpu.py) ---
    def gpu_show(self):
        cards = agpu.gpus()
        if not cards:
            return
        self.gpu_idx = max(0, min(len(cards) - 1, self.gpu_idx if self.gpu_idx is not None else cards.index(agpu.chosen())))
        g = cards[self.gpu_idx]
        kind = L("gpu_integrated" if g["integrated"] else "gpu_dedicated")
        key = "gpu_in_use" if g is agpu.chosen() else "gpu_pick"
        self.show_label(L(key, name=g["name"], kind=kind), self.gpu_idx / max(1, len(cards) - 1))

    def gpu_step(self, d):
        cards = agpu.gpus(refresh=True)
        cur = self.gpu_idx if self.gpu_idx is not None else cards.index(agpu.chosen())
        self.gpu_idx = (cur + d) % len(cards)
        self.gpu_show()

    def gpu_click(self):
        cards = agpu.gpus(refresh=True)
        if self.gpu_idx is None or self.gpu_idx >= len(cards):
            self.gpu_idx = cards.index(agpu.chosen())
        g = cards[self.gpu_idx]
        if agpu.apply(g):
            self.show_label(L("gpu_set", name=g["name"]), self.gpu_idx / max(1, len(cards) - 1))
        else:
            self.show_label(L("gpu_failed"))

    # --- power profile: clockwise = faster, counter-clockwise = saves more; a click goes round them ---
    def profile_step(self, d, wrap=False):
        have = self.desk.power_profiles()
        if not have:
            self.show_label(L("profile_na"))
            return
        now = self.desk.power_profile()
        i = (have.index(now) if now in have else 0) + d
        i = i % len(have) if wrap else max(0, min(len(have) - 1, i))
        if have[i] != now:
            self.desk.set_power_profile(have[i])
        self.show_profile()

    def show_profile(self):
        have = self.desk.power_profiles()
        now = self.desk.power_profile()
        if now not in have:
            self.show_label(L("profile_na"))
            return
        self.show_label(L("profile_" + now), have.index(now) / max(1, len(have) - 1))

