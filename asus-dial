            else:  # ... or the little house that comes with the program
                o.image = ath.house_picture(HOUSE_WIDTH, HOUSE_WIDTH * 3 // 4)
        o.angle += delta * -self.sign * HOUSE_DEG_PER_UNIT
        o.show_for("image", 1500)

    # --- AI: robot animation, then a terminal opens the chat (asus-dial-ai installs Ollama / the model if needed) ---
    def load_ai_level(self):
        try:
            return max(0, min(len(AI_LEVELS) - 1, int(open(AI_FILE).read())))
        except (OSError, ValueError):
            return 0

    def save_ai_level(self):
        try:
            os.makedirs(os.path.dirname(AI_FILE), exist_ok=True)
            with open(AI_FILE, "w") as f:
                f.write(str(self.ai_level))
        except OSError:
            pass

    def ai_level_name(self):
        """Name of the picked model; for the custom level the one chosen in the AI app ("" if none yet)."""
        arg, name, _size = AI_LEVELS[self.ai_level]
        if arg != "custom":
            return name
        try:
            with open(AI_APP_CONFIG) as f:
                return str(json.load(f).get("custom_model", "")).strip()
        except (OSError, ValueError, AttributeError):
            return ""

    def show_ai_label(self):
        _arg, _name, size = AI_LEVELS[self.ai_level]
        lvl, name = AI_LEVEL_NAMES[_lang[0]][self.ai_level], self.ai_level_name()
        if _arg == "custom":
            text = L("ai_pick_custom", lvl=lvl, name=name or L("ai_custom_none"))
        else:
            text = L("ai_pick", lvl=lvl, name=name, size=size)
        pre, lvl, post = text.split("|", 2)  # the level name is drawn in its own colour (MAX: rainbow)
        self.show_label([(pre, None), (lvl, AI_LEVEL_COLORS[self.ai_level]), (post, None)], self.ai_level / (len(AI_LEVELS) - 1))

    def ai_start(self):
        if self.ai_busy:
            return
        self.ai_busy = True
        name = self.ai_level_name() or AI_LEVEL_NAMES[_lang[0]][self.ai_level]
        self.robot_win.play(make_robot_draw(L("robot_hi", name=name)), ROBOT_ANIM_S, size=(560, 520), fps=30,
                            on_done=lambda: setattr(self, "ai_busy", False))
        GLib.timeout_add(int(ROBOT_OPEN_AT_S * 1000), self.ai_open_app)

    def ai_open_app(self):
        arg = AI_LEVELS[self.ai_level][0]
        if ai_tell_app("open " + arg):  # already running: it just comes forward with this model
            return False
        script = os.path.join(os.path.dirname(os.path.realpath(__file__)), AI_SCRIPT)
        if not os.path.exists(script):
            script = os.path.expanduser(f"~/.local/bin/{AI_SCRIPT}")
        try:
            # the dial itself runs on X11 (GDK_BACKEND=x11); the chat must not inherit it, or the desktop cannot tell which launcher
            # (name, icon) the window belongs to
            env = {k: v for k, v in os.environ.items() if k != "GDK_BACKEND"}
            subprocess.Popen([script, "--model", arg], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True, env=env)
        except OSError:
            self.show_label(L("ai_no_terminal"))
        return False

    # --- rickroll: divine animation, then the browser opens the video full screen ---
    def rick_start(self):
        if self.rick_busy:
            return
        self.rick_busy = True
        if os.path.exists(RICK_SOUND):
            subprocess.Popen(["paplay", RICK_SOUND], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.divine_win.play(make_divine_draw(), RICK_ANIM_S, fps=30, on_done=lambda: setattr(self, "rick_busy", False))
        GLib.timeout_add(int(RICK_OPEN_AT_S * 1000), self.rick_open)

    def rick_open(self):
        subprocess.Popen(["xdg-open", RICKROLL_URL], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.rick_polls = 0
        GLib.timeout_add(500, self.rick_wait_page)
        return False

    def rick_wait_page(self):
        """Wait until the active window is the YouTube page, then make sure it plays and goes full screen."""
        self.rick_polls += 1
        if "youtube" in self._active_title().lower():
            GLib.timeout_add(2500, self.rick_fullscreen)
            return False
        return self.rick_polls < 40  # give up after ~20 s

    def rick_fullscreen(self):
        if not self._anything_playing():
            self.ui.tap(KEY_K)  # autoplay was blocked: start the video
        GLib.timeout_add(500, lambda: (self.ui.tap(KEY_F), False)[1])  # YouTube's full-screen key
        return False

    def _active_title(self):
        return self.desk.active_title()

    def _anything_playing(self):
        for name in self._mpris_players():
            try:
                r = self.bus.call_sync(name, "/org/mpris/MediaPlayer2", "org.freedesktop.DBus.Properties", "Get",
                                       GLib.Variant("(ss)", ("org.mpris.MediaPlayer2.Player", "PlaybackStatus")),
                                       None, Gio.DBusCallFlags.NONE, 500, None)
                if r.unpack()[0] == "Playing":
                    return True
            except GLib.Error:
                continue
        return False

    # --- language ---
