def hex_rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) / 255 for i in (0, 2, 4))


def to_hex(rgb):
    return "#%02x%02x%02x" % tuple(round(max(0, min(1, c)) * 255) for c in rgb)


def shift_hue(rgb, d):
    h, s, v = colorsys.rgb_to_hsv(*rgb)
    return colorsys.hsv_to_rgb((h + d) % 1.0, s, v)


def rainbow(t, i=0.0, s=0.7, v=1.0):
    return colorsys.hsv_to_rgb((t * 0.2 + i * 0.08) % 1.0, s, v)


def model_colors(mid, t):
    """Three colours that dress an orb / a label for the model."""
    m = model_by_id(mid)
    if m["color"] == "rainbow":
        return [rainbow(t, 0), rainbow(t, 2.2), rainbow(t, 4.4)]
    b = hex_rgb(m["color"])
    return [b, shift_hue(b, 0.07), shift_hue(b, -0.07)]


