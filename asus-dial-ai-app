# ------------------------------------------------------------------------------------------------ small widgets
def ease(x):
    x = max(0.0, min(1.0, x))
    return 1 - (1 - x) ** 3


class Ticker:
    """Mixin: a frame callback that only draws while the widget is shown, capped to fps."""

    def start_ticks(self, fps=40):
        self._tick_gap = 1.0 / fps
        self._last_tick = 0.0
        self.t = 0.0
        self._tick_id = self.add_tick_callback(self._on_tick)

    def _on_tick(self, w, clock):
        now = clock.get_frame_time() / 1e6
        if self.get_mapped() and now - self._last_tick >= self._tick_gap and self.should_tick():
            dt = min(0.1, now - self._last_tick) if self._last_tick else 0.0
            self._last_tick = now
            self.t = now
            self.step(dt)
            self.queue_draw()
        return True

    def step(self, dt):
        pass

    def should_tick(self):
        return True


class Orb(Gtk.DrawingArea, Ticker):
    """The AI bubble: a liquid orb that breathes, thinks, listens and speaks."""

    def __init__(self, app, size=64, animated=True):
        super().__init__()
        self.app, self.state, self.model = app, "idle", "low"
        self.level, self.lv = 0.0, 0.0
        self.level_fn = None
        self.set_size_request(size, size)
        self.connect("draw", self.on_draw)
        self.always = size > 100  # big orbs always live; the little avatar of a message only while it is answering
        self.rf = 0.62 if size > 100 else 0.7
        self.t = 0.0
        self.start_ticks(40)

    def should_tick(self):
        return self.always or self.state != "idle"

    def set_state(self, s):
        self.state = s
        self.queue_draw()

    def step(self, dt):
        if not self.app.cfg["animations"]:
            return
        tgt = self.level_fn() if self.level_fn else None
        if tgt is None:
            tgt = {"idle": 0.05, "thinking": 0.22, "listening": 0.12, "speaking": 0.3 + 0.25 * math.sin(self.t * 9)}.get(self.state, 0.05)
        self.lv += (tgt - self.lv) * min(1.0, dt * 12)

    def on_draw(self, w, cr):
        W, H = self.get_allocated_width(), self.get_allocated_height()
        cx, cy = W / 2, H / 2
        R = min(W, H) / 2 * self.rf
        t = self.t if self.app.cfg["animations"] else 0.0
        lv = self.lv
        cols = model_colors(self.model, t)
        dark = self.app.style.dark
        style = self.app.cfg["orb"]
        # halo
        g = cairo.RadialGradient(cx, cy, R * 0.5, cx, cy, R * (1.55 + 0.5 * lv))
        g.add_color_stop_rgba(0, *cols[0], 0.30 + 0.35 * lv)
        g.add_color_stop_rgba(1, *cols[0], 0)
        cr.set_source(g)
        cr.paint()
        # rings when listening or in the "rings" look
        if self.state == "listening" or style == "rings":
            for j in range(3):
                ph = (t * 0.6 + j / 3) % 1.0
                cr.arc(cx, cy, R * (1.0 + ph * (0.5 + lv)), 0, 2 * math.pi)
                cr.set_source_rgba(*cols[j % 3], (1 - ph) * (0.35 + lv * 0.5))
                cr.set_line_width(2)
                cr.stroke()
        if style != "rings":
            cr.set_operator(cairo.OPERATOR_ADD if dark else cairo.OPERATOR_OVER)
            amp = 0.05 + 0.2 * lv
            for k in range(3):
                n = 72
                for i in range(n + 1):
                    th = 2 * math.pi * i / n
                    r = R * (1 + amp * math.sin(3 * th + t * (1.1 + 0.4 * k) + k * 2.1) + amp * 0.6 * math.sin(5 * th - t * (1.7 + 0.3 * k) + k))
                    x, y = cx + r * math.cos(th), cy + r * math.sin(th)
                    cr.line_to(x, y) if i else cr.move_to(x, y)
                cr.close_path()
                g = cairo.RadialGradient(cx - R * 0.35, cy - R * 0.4, R * 0.1, cx, cy, R * 1.25)
                g.add_color_stop_rgba(0, *cols[k], 0.5 if dark else 0.85)
                g.add_color_stop_rgba(1, *cols[(k + 1) % 3], 0.2 if dark else 0.55)
                cr.set_source(g)
                cr.fill()
            cr.set_operator(cairo.OPERATOR_OVER)
        else:
            g = cairo.RadialGradient(cx - R * 0.3, cy - R * 0.3, R * 0.1, cx, cy, R)
            g.add_color_stop_rgba(0, *cols[0], 0.95)
            g.add_color_stop_rgba(1, *cols[1], 0.7)
            cr.arc(cx, cy, R * (0.8 + 0.2 * lv), 0, 2 * math.pi)
            cr.set_source(g)
            cr.fill()
        # glassy highlight
        g = cairo.RadialGradient(cx - R * 0.35, cy - R * 0.42, 0, cx - R * 0.35, cy - R * 0.42, R * 0.55)
        g.add_color_stop_rgba(0, 1, 1, 1, 0.55)
        g.add_color_stop_rgba(1, 1, 1, 1, 0)
        cr.arc(cx, cy, R * 1.02, 0, 2 * math.pi)
        cr.set_source(g)
        cr.fill()
        # thinking: two orbiting arcs
        if self.state == "thinking":
            for j in range(2):
                a = t * 2.6 + j * math.pi
                cr.arc(cx, cy, R * 1.28, a, a + 1.1)
                cr.set_source_rgba(*cols[j], 0.9)
                cr.set_line_width(max(2, R * 0.07))
                cr.set_line_cap(cairo.LINE_CAP_ROUND)
                cr.stroke()
        # sparkles
        if style == "spark":
            for j in range(4):
                a = t * 0.8 + j * math.pi / 2
                sx, sy = cx + R * 1.35 * math.cos(a), cy + R * 1.35 * math.sin(a)
                s = R * 0.13 * (0.6 + 0.4 * math.sin(t * 3 + j))
                cr.move_to(sx, sy - s * 2)
                cr.curve_to(sx, sy, sx, sy, sx + s * 2, sy)
                cr.curve_to(sx, sy, sx, sy, sx, sy + s * 2)
                cr.curve_to(sx, sy, sx, sy, sx - s * 2, sy)
                cr.curve_to(sx, sy, sx, sy, sx, sy - s * 2)
                cr.set_source_rgba(1, 1, 1, 0.85)
                cr.fill()


def draw_text(cr, s, x, y, font, color):
    layout = PangoCairo.create_layout(cr)
    layout.set_font_description(Pango.FontDescription(font))
    layout.set_text(s, -1)
    w, h = layout.get_pixel_size()
    cr.set_source_rgba(*color)
    cr.move_to(x, y - h / 2)
    PangoCairo.show_layout(cr, layout)
    return w


def text_width(widget, s, font):
    layout = widget.create_pango_layout(s)
    layout.set_font_description(Pango.FontDescription(font))
    return layout.get_pixel_size()[0]


def draw_rainbow_text(cr, s, x, y, font, t, alpha=1.0):
    layout = PangoCairo.create_layout(cr)
    layout.set_font_description(Pango.FontDescription(font))
    for i, ch in enumerate(s):
        layout.set_text(ch, -1)
        w, h = layout.get_pixel_size()
        cr.set_source_rgba(*rainbow(t, i * 1.0, 0.75, 1.0), alpha)
        cr.move_to(x, y - h / 2)
        PangoCairo.show_layout(cr, layout)
        x += w
    return x


class LevelTag(Gtk.DrawingArea, Ticker):
    """The model's level name (Low / Medium / High / MAX) in its colour; MAX is an animated rainbow."""

    def __init__(self, app, mid, size_px=12):
        super().__init__()
        self.app, self.mid = app, mid
        self.font = f"Sans Bold {size_px}px"
        self.label = core.LEVEL_NAMES[core.LANG[0]][core.MODEL_IDS.index(mid)]
        self.set_size_request(text_width(self, self.label, self.font) + 4, size_px + 8)
        self.connect("draw", self.on_draw)
        self.t = 0.0
        if model_by_id(mid)["color"] == "rainbow":
            self.start_ticks(24)

    def on_draw(self, w, cr):
        y = self.get_allocated_height() / 2
        if model_by_id(self.mid)["color"] == "rainbow":
            draw_rainbow_text(cr, self.label, 2, y, self.font, self.t if self.app.cfg["animations"] else 0)
        else:
            draw_text(cr, self.label, 2, y, self.font, (*hex_rgb(model_by_id(self.mid)["color"]), 1.0))


class ModelSwitcher(Gtk.DrawingArea, Ticker):
    """The models as a pill track; the highlight slides, the wheel of the dial (and the mouse wheel) change it."""

    H = 38

    def __init__(self, app, on_select):
        super().__init__()
        self.app, self.on_select = app, on_select
        self.idx, self.pos, self.pos_from, self.pos_t0 = 0, 0.0, 0.0, 0.0
        self.font = "Sans Bold 12"
        self.labels = core.LEVEL_NAMES[core.LANG[0]]
        self.widths = [text_width(self, s, self.font) + 30 for s in self.labels]
        self.set_size_request(sum(self.widths) + 10, self.H)
        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.SCROLL_MASK | Gdk.EventMask.SMOOTH_SCROLL_MASK)
        self.connect("draw", self.on_draw)
        self.connect("button-press-event", self.on_click)
        self.connect("scroll-event", self.on_scroll)
        self.set_has_tooltip(True)
        self.connect("query-tooltip", self.on_tip)
        self.start_ticks(60)

    def lefts(self):
        x, out = 5, []
        for w in self.widths:
            out.append(x)
            x += w
        return out

    def set_active(self, idx, animate=True):
        if idx == self.idx and self.pos_t0 == 0.0:
            return
        self.pos_from = self.cur_pos()
        self.idx = idx
        self.pos_t0 = time.time() if animate and self.app.cfg["animations"] else -1
        self.queue_draw()

    def cur_pos(self):
        if self.pos_t0 in (0.0, -1):
            return float(self.idx)
        k = ease((time.time() - self.pos_t0) / (0.32 / max(0.2, self.app.cfg["anim_speed"])))
        return self.pos_from + (self.idx - self.pos_from) * k

    def hit(self, x):
        for i, l in enumerate(self.lefts()):
            if l <= x < l + self.widths[i]:
                return i
        return None

    def on_click(self, w, ev):
        i = self.hit(ev.x)
        if i is not None:
            self.on_select(core.MODEL_IDS[i])

    def on_scroll(self, w, ev):
        d = 0
        if ev.direction == Gdk.ScrollDirection.UP:
            d = -1
        elif ev.direction == Gdk.ScrollDirection.DOWN:
            d = 1
        elif ev.direction == Gdk.ScrollDirection.SMOOTH:
            d = 1 if ev.delta_y > 0.2 else -1 if ev.delta_y < -0.2 else 0
        if d:
            self.on_select(core.MODEL_IDS[max(0, min(len(MODELS) - 1, self.idx + d))])
        return True

    def on_tip(self, w, x, y, kb, tip):
        i = self.hit(x)
        if i is None:
            return False
        m = MODELS[i]
        tip.set_text(m["name"] if m["id"] == "custom" else f"{m['name']}  ({m['size']})")
        return True

    def on_draw(self, w, cr):
        W, H = self.get_allocated_width(), self.get_allocated_height()
        r = H / 2
        line = (1, 1, 1) if self.app.style.dark else (0, 0, 0)
        t = self.t if self.app.cfg["animations"] else 0.0
        # track
        cr.new_sub_path()
        cr.arc(r, r, r, math.pi / 2, 3 * math.pi / 2)
        cr.arc(W - r, r, r, -math.pi / 2, math.pi / 2)
        cr.close_path()
        cr.set_source_rgba(*line, 0.08)
        cr.fill()
        lefts = self.lefts()
        p = self.cur_pos()
        i0 = int(math.floor(p))
        i1 = min(len(MODELS) - 1, i0 + 1)
        f = p - i0
        x = lefts[i0] + (lefts[i1] - lefts[i0]) * f
        wd = self.widths[i0] + (self.widths[i1] - self.widths[i0]) * f
        col = model_colors(core.MODEL_IDS[round(p)], t)[0]
        # the sliding highlight
        hr = (H - 8) / 2
        y0 = 4
        cr.new_sub_path()
        cr.arc(x + hr, y0 + hr, hr, math.pi / 2, 3 * math.pi / 2)
        cr.arc(x + wd - hr, y0 + hr, hr, -math.pi / 2, math.pi / 2)
        cr.close_path()
        cr.set_source_rgba(*col, 0.25)
        cr.fill_preserve()
        cr.set_source_rgba(*col, 0.85)
        cr.set_line_width(1.5)
        cr.stroke()
        for i, s in enumerate(self.labels):
            lx = lefts[i] + (self.widths[i] - text_width(self, s, self.font)) / 2
            sel = abs(p - i) < 0.5
            if MODELS[i]["color"] == "rainbow":
                draw_rainbow_text(cr, s, lx, H / 2, self.font, t, 1.0 if sel else 0.7)
            else:
                draw_text(cr, s, lx, H / 2, self.font, (*hex_rgb(MODELS[i]["color"]), 1.0 if sel else 0.7))


class Dots(Gtk.DrawingArea, Ticker):
    """Three bouncing dots while the AI has not said anything yet."""

    def __init__(self, app):
        super().__init__()
        self.app = app
        self.set_size_request(44, 22)
        self.connect("draw", self.on_draw)
        self.start_ticks(30)

    def on_draw(self, w, cr):
        col = hex_rgb(self.app.style.pal["dim"])
        for i in range(3):
            y = 11 - 5 * max(0.0, math.sin(self.t * 6 - i * 0.7))
            cr.arc(8 + i * 14, y, 3.4, 0, 2 * math.pi)
            cr.set_source_rgba(*col, 0.9)
            cr.fill()


class Backdrop(Gtk.DrawingArea, Ticker):
    """Slow, soft colour clouds behind the chat."""

    def __init__(self, app):
        super().__init__()
        self.app = app
        self.connect("draw", self.on_draw)
        self.start_ticks(15)

    def on_draw(self, w, cr):
        if self.app.cfg["background"] != "aurora":
            return
        W, H = self.get_allocated_width(), self.get_allocated_height()
        t = self.t * 0.15 if self.app.cfg["animations"] else 0.0
        acc = hex_rgb(self.app.cfg["accent"])
        al = 0.16 if self.app.style.dark else 0.12
        for k, d in enumerate((0.0, 0.12, -0.12)):
            x = W * (0.5 + 0.38 * math.sin(t * (1 + 0.3 * k) + k * 2.1))
            y = H * (0.5 + 0.34 * math.cos(t * (0.8 + 0.25 * k) + k * 1.3))
            r = max(W, H) * 0.55
            g = cairo.RadialGradient(x, y, 0, x, y, r)
            g.add_color_stop_rgba(0, *shift_hue(acc, d), al)
            g.add_color_stop_rgba(1, *shift_hue(acc, d), 0)
            cr.set_source(g)
            cr.paint()


