class SettingsWindow(Gtk.Window):
    def __init__(self, app):
        super().__init__(title=T("settings"), transient_for=app.win, modal=False)
        self.app, self.cfg = app, app.cfg
        self.set_default_size(560, 560)
        self.get_style_context().add_class("settings")
        nb = Gtk.Notebook()
        self.add(nb)
        nb.append_page(self.page_appearance(), Gtk.Label(label=T("s_appearance")))
        nb.append_page(self.page_anim(), Gtk.Label(label=T("s_animations")))
        nb.append_page(self.page_chat(), Gtk.Label(label=T("s_chat")))
        nb.append_page(self.page_voice(), Gtk.Label(label=T("s_voice")))
        nb.append_page(self.page_max(), Gtk.Label(label=T("s_max")))
        self.show_all()

    def grid(self):
        g = Gtk.Grid(column_spacing=16, row_spacing=14, margin=22)
        g.n = 0
        return g

    def row(self, g, label, widget, wide=False):
        lab = Gtk.Label(label=label, xalign=0)
        lab.set_line_wrap(True)
        if wide:
            g.attach(lab, 0, g.n, 2, 1)
            g.attach(widget, 0, g.n + 1, 2, 1)
            g.n += 2
        else:
            lab.set_hexpand(True)
            widget.set_halign(Gtk.Align.END)
            g.attach(lab, 0, g.n, 1, 1)
            g.attach(widget, 1, g.n, 1, 1)
            g.n += 1

    def combo(self, key, items):
        c = Gtk.ComboBoxText()
        for v, label in items:
            c.append(str(v), label)
        c.set_active_id(str(self.cfg[key]))
        c.connect("changed", lambda w: self.cfg.set(key, type(self.cfg[key])(w.get_active_id())) if not isinstance(self.cfg[key], bool) else None)
        return c

    def switch(self, key):
        s = Gtk.Switch(active=self.cfg[key])
        s.connect("notify::active", lambda w, _p: self.cfg.set(key, w.get_active()))
        return s

    def scale(self, key, lo, hi, step, digits=0):
        s = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, lo, hi, step)
        s.set_value(self.cfg[key])
        s.set_digits(digits)
        s.set_size_request(220, -1)
        s.connect("value-changed", lambda w: self.cfg.set(key, round(w.get_value()) if digits == 0 else round(w.get_value(), digits)))
        return s

    def spin(self, key, lo, hi, step):
        s = Gtk.SpinButton.new_with_range(lo, hi, step)
        s.set_value(self.cfg[key])
        s.connect("value-changed", lambda w: self.cfg.set(key, int(w.get_value())))
        return s

    def page_appearance(self):
        g = self.grid()
        self.row(g, T("s_theme"), self.combo("theme", [(k, T("t_" + k)) for k in THEMES]))
        cb = Gtk.ColorButton.new_with_rgba(Gdk.RGBA(*hex_rgb(self.cfg["accent"]), 1))
        cb.connect("color-set", lambda w: self.cfg.set("accent", to_hex((w.get_rgba().red, w.get_rgba().green, w.get_rgba().blue))))
        self.row(g, T("s_accent"), cb)
        self.row(g, T("s_font"), self.scale("font_size", 11, 22, 1))
        self.row(g, T("s_radius"), self.scale("radius", 4, 32, 1))
        self.row(g, T("s_bg"), self.combo("background", [("aurora", T("s_aurora")), ("plain", T("s_plain"))]))
        self.row(g, T("s_orb"), self.combo("orb", [("blob", T("s_blob")), ("rings", T("s_rings")), ("spark", T("s_spark"))]))
        return g

    def page_anim(self):
        g = self.grid()
        self.row(g, T("s_anim_on"), self.switch("animations"))
        self.row(g, T("s_anim_speed"), self.scale("anim_speed", 0.3, 2.5, 0.1, 1))
        self.row(g, T("s_msg_anim"), self.combo("msg_anim", [("slide", T("s_slide")), ("fade", T("s_fade")), ("none", T("s_none"))]))
        self.row(g, T("s_smooth"), self.switch("smooth_scroll"))
        return g

    def page_chat(self):
        g = self.grid()
        tv = Gtk.TextView(wrap_mode=Gtk.WrapMode.WORD, left_margin=8, right_margin=8, top_margin=6, bottom_margin=6)
        tv.get_buffer().set_text(self.cfg["system_prompt"])
        tv.get_buffer().connect("changed", lambda b: self.cfg.set("system_prompt", b.get_text(b.get_start_iter(), b.get_end_iter(), False)))
        sw = Gtk.ScrolledWindow(shadow_type=Gtk.ShadowType.IN, min_content_height=110)
        sw.add(tv)
        self.row(g, T("s_system"), sw, wide=True)
        combo = self.app.custom_model_combo()
        combo.get_child().set_text(self.cfg["custom_model"])
        combo.connect("changed", lambda c: self.app.set_custom_model(c.get_active_text() or ""))
        self.row(g, T("custom_text"), combo, wide=True)
        self.row(g, T("s_temp"), self.scale("temperature", 0, 1.5, 0.05, 2))
        self.row(g, T("s_tokens"), self.spin("max_tokens", 64, 8192, 64))
        self.row(g, T("s_think"), self.switch("show_thinking"))
        self.row(g, T("s_enter"), self.switch("enter_sends"))
        self.row(g, T("s_tools"), self.switch("dial_tools"))
        return g

    def page_voice(self):
        g = self.grid()
        self.row(g, T("s_tts"), self.switch("tts"))
        self.row(g, T("s_autospeak"), self.switch("auto_speak"))
        self.row(g, T("s_vlang"), self.combo("voice_lang", [("auto", T("s_auto")), ("en", "English"), ("es", "Español"), ("it", "Italiano")]))
        pc = Gtk.ComboBoxText()
        for pid in core.VOICE_PRESETS:
            pc.append(pid, T("p_" + pid))
        pc.set_active_id(self.cfg["voice_preset"])
        self.row(g, T("s_preset"), pc)
        self.vscales = {}
        for key, label, lo, hi, step in (("voice_speed", "s_vspeed", 0.5, 1.8, 0.05), ("voice_pitch", "s_vpitch", 0.6, 1.6, 0.02),
                                         ("voice_volume", "s_vvol", 0.2, 1.5, 0.05), ("voice_var", "s_vvar", 0.0, 1.6, 0.05)):
            sc = self.scale(key, lo, hi, step, 2)
            self.vscales[key] = sc
            self.row(g, T(label), sc)
        fx = self.combo("voice_fx", [("none", T("fx_none")), ("robot", T("fx_robot")), ("echo", T("fx_echo"))])
        self.vscales["voice_fx"] = fx
        self.row(g, T("s_vfx"), fx)

        def preset_changed(w):
            pid = w.get_active_id()
            self.cfg.set("voice_preset", pid)
            for k, v in core.preset_values(pid).items():  # a preset sets the sliders; touch them afterwards to make it yours
                if k == "voice_fx":
                    self.vscales[k].set_active_id(v)
                else:
                    self.vscales[k].set_value(v)
                self.cfg.set(k, v)
        pc.connect("changed", preset_changed)
        test = Gtk.Button(label="▶  " + T("s_test"))
        test.get_style_context().add_class("primary")
        test.connect("clicked", lambda *_: self.app.read_aloud(T("test_text")))
        self.row(g, "", test)
        self.row(g, T("s_stt"), self.combo("stt_size", [("tiny", "Tiny"), ("base", "Base"), ("small", "Small"), ("medium", "Medium")]))
        return g

    def page_max(self):
        g = self.grid()
        self.row(g, T("s_comp"), self.combo("compression", [("4bit", "4-bit"), ("8bit", "8-bit"), ("none", T("s_none"))]))
        self.row(g, T("s_tokens_max"), self.spin("max_tokens_max", 16, 2048, 16))
        self.row(g, T("s_delorig"), self.switch("delete_original"))
        return g


