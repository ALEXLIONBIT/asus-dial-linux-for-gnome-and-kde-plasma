    # ----- helpers
    def on_config(self, key):
        if key in ("theme", "accent", "font_size", "radius"):
            self.style.apply()
        if key in ("font_size", "radius"):
            self.refit()
        if key == "auto_speak":
            if self.speak_btn.get_active() != self.cfg["auto_speak"]:
                self.speak_btn.set_active(self.cfg["auto_speak"])
            if self.vspk_btn.get_active() != self.cfg["auto_speak"]:
                self.vspk_btn.set_active(self.cfg["auto_speak"])
            if self.voice:
                if self.cfg["auto_speak"]:
                    self.voice.hush.clear()
                else:
                    self.voice.hush.set()  # also drops the sentence being synthesized right now
            if not self.cfg["auto_speak"]:
                self.barge_in(stop_gen=False)
                self.spoken_upto = len(core.speakable(self.buf))  # what is still coming is not read later if it is switched on again
        if key == "orb" or key == "theme":
            self.queue_all()
        if key == "sidebar":
            return

    def queue_all(self):
        self.win.queue_draw()

    def screenshot(self, path):
        W, H = self.win.get_allocated_width(), self.win.get_allocated_height()
        surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, W, H)
        cr = cairo.Context(surf)
        cr.set_source_rgb(*hex_rgb(self.style.pal["bg"]))
        cr.paint()
        self.win.draw(cr)
        surf.write_to_png(path)
        Gtk.main_quit()
        return False

    def on_key(self, w, ev):
        ctrl = ev.state & Gdk.ModifierType.CONTROL_MASK
        if ctrl and ev.keyval == Gdk.KEY_n:
            self.new_chat()
            return True
        if ev.keyval == Gdk.KEY_Escape and self.voice_on:
            self.toggle_voice()
            return True
        focus = self.win.get_focus()
        if (not ctrl and ev.string.strip() and ev.string.isprintable() and self.input.get_sensitive()
                and not isinstance(focus, (Gtk.Entry, Gtk.TextView, Gtk.SearchEntry, Gtk.SpinButton))):
            self.input.grab_focus()  # typing while a list row or button has the focus starts the message
        return False

    def on_close(self, *_):
        w, h = self.win.get_size()
        self.cfg.set("win_w", w)
        self.cfg.set("win_h", h)
        self.voice_stop()
        self.engine.shutdown()
        try:
            os.remove(SOCK)
        except OSError:
            pass
        Gtk.main_quit()
        return False

    def toast(self, text):
        self.toast_label.set_text(text)
        self.toast_rev.set_reveal_child(True)
        self._toast_id = getattr(self, "_toast_id", 0) + 1
        mine = self._toast_id
        GLib.timeout_add(2200, lambda: (self.toast_rev.set_reveal_child(False) if mine == self._toast_id else None) and False)

    def show_confirm(self, title, text, yes, res, ev):
        d = Gtk.MessageDialog(transient_for=self.win, modal=True, message_type=Gtk.MessageType.QUESTION, text=title, secondary_text=text)
        d.add_button(T("cancel"), Gtk.ResponseType.CANCEL)
        d.add_button(yes, Gtk.ResponseType.OK).get_style_context().add_class("suggested-action")
        d.set_default_response(Gtk.ResponseType.OK)
        res[0] = d.run() == Gtk.ResponseType.OK
        d.destroy()
        ev.set()
        return False

    def banner_update(self, text, frac, lines):
        if text is None and not self.banner.get_reveal_child():
            return False
        if text is not None:
            self.banner_label.set_text(text)
            if frac is None:
                self.banner_bar.pulse()
                self._pulse = True
            else:
                self._pulse = False
                self.banner_bar.set_fraction(frac)
        if lines:
            self.banner_log.set_text(lines[-1][-110:])
        if not self.banner.get_reveal_child():
            self.banner.set_reveal_child(True)
            GLib.timeout_add(120, self._pulse_bar)
        return False

    def _pulse_bar(self):
        if not self.banner.get_reveal_child():
            return False
        if getattr(self, "_pulse", False):
            self.banner_bar.pulse()
        return True

    def banner_hide(self):
        self.banner.set_reveal_child(False)
        return False

