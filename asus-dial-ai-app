    def set_custom_model(self, tag):
        tag = tag.strip()
        self.cfg.set("custom_model", tag)
        core.set_custom_model(tag)
        self.ready.discard("custom")  # a different model behind the same name: it has to be made ready again

    def ask_custom_model(self):
        """Ask which model "custom" is. False if nothing was chosen."""
        d = Gtk.MessageDialog(transient_for=self.win, modal=True, message_type=Gtk.MessageType.QUESTION,
                              text=T("custom_title"), secondary_text=T("custom_text"))
        d.add_button(T("cancel"), Gtk.ResponseType.CANCEL)
        d.add_button(T("custom_ok"), Gtk.ResponseType.OK).get_style_context().add_class("suggested-action")
        d.set_default_response(Gtk.ResponseType.OK)
        combo = self.custom_model_combo()
        combo.get_child().set_text(self.cfg["custom_model"])
        combo.get_child().set_activates_default(True)
        d.get_message_area().pack_start(combo, False, False, 0)
        d.show_all()
        ok = d.run() == Gtk.ResponseType.OK
        tag = (combo.get_active_text() or "").strip()
        d.destroy()
        if ok and tag:
            self.set_custom_model(tag)
        return bool(ok and tag)

    def set_model(self, mid, quiet=False, present=False, ask=False):
        if mid not in core.MODEL_IDS:
            return
        if mid == "custom" and ask and not self.cfg["custom_model"] and not self.ask_custom_model():
            return
        self.cfg.set("model", mid)
        self.switcher.set_active(core.MODEL_IDS.index(mid), animate=not quiet)
        for o in (self.empty_orb, self.voice_orb):
            o.model = mid
        m = model_by_id(mid)
        self.hint.set_text(T("need_slow") if m["backend"] == "airllm" else "")
        self.hint.get_style_context().remove_class("hint")
        self.hint.get_style_context().add_class("warn" if m["backend"] == "airllm" else "hint")
        if not quiet:
            self.toast(T("custom_none") if m["id"] == "custom" and not m["tag"] else T("now_running", name=m["name"]))
        if present:
            self.win.present()

    # ----- chats
    def refresh_chats(self):
        for r in self.chat_list.get_children():
            self.chat_list.remove(r)
        q = self.search.get_text().lower()
        for c in self.store.list():
            if q and q not in c["title"].lower():
                continue
            row = Gtk.ListBoxRow()
            row.cid = c["id"]
            box = Gtk.Box(spacing=4)
            box.get_style_context().add_class("chat-item")
            if c["id"] == self.chat["id"]:
                box.get_style_context().add_class("current")
            lab = Gtk.Label(label=c["title"], xalign=0, ellipsize=Pango.EllipsizeMode.END)
            box.pack_start(lab, True, True, 0)
            x = Gtk.Button(label="✕", tooltip_text=T("delete"))
            x.get_style_context().add_class("x-btn")
            x.connect("clicked", lambda _b, cid=c["id"]: self.delete_chat(cid))
            box.pack_end(x, False, False, 0)
            row.add(box)
            self.chat_list.add(row)
        self.chat_list.show_all()

    def clear_rows(self):
        for r in self.rows:
            self.msgs.remove(r)
        self.rows = []

    def new_chat(self):
        if self.busy:
            return
        self.store.save(self.chat)
        self.chat = self.store.new()
        self.clear_rows()
        self.empty_rev.set_reveal_child(True)
        self.refresh_chats()
        self.input.grab_focus()

    def open_chat(self, cid):
        if self.busy or cid == self.chat["id"]:
            return
        try:
            self.chat = self.store.load(cid)
        except (OSError, ValueError):
            return
        self.clear_rows()
        for m in self.chat["messages"]:
            self.add_row(m["role"], m["content"], m.get("model", "low"), animate=False)
        self.empty_rev.set_reveal_child(not self.chat["messages"])
        self.stick = True
        self.refresh_chats()
        self.input.grab_focus()  # the clicked row was just rebuilt: without this the keys go nowhere

    def delete_chat(self, cid):
        self.store.delete(cid)
        if cid == self.chat["id"]:
            self.chat = self.store.new()
            self.clear_rows()
            self.empty_rev.set_reveal_child(True)
        self.refresh_chats()

    def add_row(self, role, text, model, streaming=False, animate=True):
        r = MessageRow(self, role, text, model, streaming, animate)
        self.msgs.pack_start(r, False, False, 0)
        self.rows.append(r)
        self.empty_rev.set_reveal_child(False)
        self.stick = True
        return r

    # ----- sizing and scrolling
    def chars_fit(self):
        W = self.scroll.get_allocated_width()
        return max(20, min(150, int((W - 150) * 0.82 / (self.cfg["font_size"] * 0.58))))

    def fit_labels(self, row):
        n = self.chars_fit()
        for lab in row.labels:
            lab.set_max_width_chars(n)

    def refit(self):
        n = self.chars_fit()
        for r in self.rows:
            for lab in r.labels:
                lab.set_max_width_chars(n)

    def on_scrolled(self, adj):
        if not getattr(self, "_auto", False):
            self.stick = adj.get_upper() - (adj.get_value() + adj.get_page_size()) < 60

    def scroll_bottom(self, animate=True):
        adj = self.scroll.get_vadjustment()
        target = max(0.0, adj.get_upper() - adj.get_page_size())
        if not (animate and self.cfg["animations"] and self.cfg["smooth_scroll"]):
            self._auto = True
            adj.set_value(target)
            self._auto = False
            return
        start, t0 = adj.get_value(), time.time()
        dur = 0.25 / max(0.3, self.cfg["anim_speed"])

        def tick():
            k = ease((time.time() - t0) / dur)
            self._auto = True
            adj.set_value(start + (max(0.0, adj.get_upper() - adj.get_page_size()) - start) * k)
            self._auto = False
            return k < 1.0

        GLib.timeout_add(16, tick)

    # ----- composing
    def update_placeholder(self):
        b = self.input.get_buffer()
        self.ph.set_visible(b.get_char_count() == 0)

    def on_input_changed(self, b):
        self.update_placeholder()

    def on_input_key(self, w, ev):
        if ev.keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            shift = ev.state & Gdk.ModifierType.SHIFT_MASK
            if bool(shift) != bool(self.cfg["enter_sends"]):
                self.on_send_clicked()
                return True
        return False

    def on_send_clicked(self):
        if self.busy:
            self.engine.stop.set()
            self.engine.cancel.set()
            return
        b = self.input.get_buffer()
        text = b.get_text(b.get_start_iter(), b.get_end_iter(), False).strip()
        if text:
            b.set_text("")
            self.send(text)

    def set_busy(self, busy):
        self.busy = busy
        ctx = self.send_btn.get_style_context()
        icon = "media-playback-stop-symbolic" if busy else "go-up-symbolic"
        self.send_btn.set_image(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.LARGE_TOOLBAR))
        (ctx.add_class if busy else ctx.remove_class)("stop")
        self.send_btn.show_all()

    def history(self):
        out = []
        for m in self.chat["messages"]:
            c = m["content"]
            if m["role"] == "assistant":
                c = "".join(p[1] if p[0] != "code" else "```" + p[3] + "\n" + p[1] + "\n```" for p in parse_segments(c) if p[0] != "think")
            if c.strip():
                out.append({"role": m["role"], "content": c})
        total, keep = 0, []
        for m in reversed(out):
            total += len(m["content"])
            if total > 14000 and keep:
                break
            keep.append(m)
        return list(reversed(keep))

    def send(self, text, from_voice=False):
        if self.busy:
            return
        m = model_by_id(self.cfg["model"])
        if m["id"] == "custom" and not m["tag"] and not self.ask_custom_model():
            return
        self.chat["messages"].append({"role": "user", "content": text})
        if not self.chat["title"]:
            self.chat["title"] = text.replace("\n", " ")[:42]
        self.add_row("user", text, m["id"])
        self.ai_row = self.add_row("assistant", "", m["id"], streaming=True)
        self.set_busy(True)
        self.buf, self.spoken_upto = "", 0
        self.gen_done.clear()
        GLib.timeout_add(70, self.flush)
        acts = tools.quick(text) if self.cfg["dial_tools"] else None
        if acts:  # a plain command for the PC: done at once, no need to ask the model
            threading.Thread(target=self.do_commands, args=(m, acts), daemon=True).start()
            return
        threading.Thread(target=self.generate, args=(m, self.history(), not self.voice_on), daemon=True).start()

    def do_commands(self, m, acts):
        err = None
        try:
            self.on_text(tools.execute(acts, core.LANG[0]))
        except Exception as e:  # noqa: BLE001
            core.log(f"commands: {e!r}")
            err = f"{type(e).__name__}: {e}"
        GLib.idle_add(self.finish, m, err)

    def generate(self, m, hist, think):
        err = None
        try:
            if m["id"] not in self.ready:
                self.engine.ensure(m)
                self.ready.add(m["id"])
            self.engine.stream(m, hist, self.on_text, think=think)
        except core.Cancelled:
            pass
        except Exception as e:  # noqa: BLE001
            self.ready.discard(m["id"])
            core.log(f"error: {e!r}")
            err = f"{type(e).__name__}: {e}"
        GLib.idle_add(self.finish, m, err)

    def on_text(self, delta):
        with self.buf_lock:
            self.buf += delta

    def flush(self):
        with self.buf_lock:
            text = self.buf
        if self.ai_row is not None and text != self.ai_row.text:
            self.ai_row.set_text(text, streaming=True)
            if self.voice_on:
                self.voice_text.set_text(core.speakable(text)[-220:])
            if self.voice_on or self.cfg["auto_speak"]:
                self.feed_speech(text, final=False)
        return self.busy

    def finish(self, m, err):
        with self.buf_lock:
            text = self.buf
        if err:
            text = (text + "\n\n" if text else "") + "⚠ " + err
        row = self.ai_row
        if row is not None:
            row.set_text(text, streaming=False)
        self.chat["messages"].append({"role": "assistant", "content": text, "model": m["id"]})
        self.store.save(self.chat)
        self.refresh_chats()
        self.set_busy(False)
        if (self.voice_on or self.cfg["auto_speak"]) and not err:
            self.feed_speech(text, final=True)
        self.gen_done.set()
        self.ai_row = None
        return False

    # ----- voice
    def read_aloud(self, text):
        threading.Thread(target=self._read_aloud, args=(text,), daemon=True).start()

    def _read_aloud(self, text):
        try:
            if self.voice is None:
                self.voice = core.Voice(self.cfg, self.ui)
            self.voice.cancel.clear()
            self.voice.hush.clear()
            self.voice.start(stt=False)
            self.voice.speak(core.speakable(text))
        except Exception as e:  # noqa: BLE001
            core.log(f"read aloud: {e!r}")
            GLib.idle_add(self.toast, str(e)[:120])

    def mic_is_on(self):
        return self.voice_on and not (self.voice and self.voice.mute_mic.is_set())

    def show_mic_icons(self):
        """The microphone buttons of the chat (top bar and message bar) show whether the microphone is listening."""
        on = self.mic_is_on()
        self._sync = True
        for b, size in ((self.mic_btn, Gtk.IconSize.LARGE_TOOLBAR), (self.head_mic, Gtk.IconSize.BUTTON)):
            b.set_active(on)
            b.set_image(Gtk.Image.new_from_icon_name("audio-input-microphone-symbolic" if on else "microphone-disabled-symbolic", size))
            b.show_all()
        self._sync = False

    def on_mic_clicked(self, b):
        if getattr(self, "_sync", False):
            return
        if self.voice_on and b.get_active():  # it was muted in the voice mode: listening again
            self.vmic_btn.set_active(True)
        elif self.voice_on:
            self.vmic_btn.set_active(False)
        else:
            self.toggle_voice()
        self.show_mic_icons()

    def show_voice_icons(self):
        for b, on, off in ((self.vmic_btn, "audio-input-microphone-symbolic", "microphone-disabled-symbolic"),
                           (self.vspk_btn, "audio-volume-high-symbolic", "audio-volume-muted-symbolic")):
            b.set_image(Gtk.Image.new_from_icon_name(on if b.get_active() else off, Gtk.IconSize.LARGE_TOOLBAR))
            b.show_all()

    def on_vmic_toggled(self, b):
        self.show_voice_icons()
        if not self.voice:
            self.show_mic_icons()
            return
        if b.get_active():
            self.voice.mute_mic.clear()
            self.set_vstate("listening")
        else:
            self.voice.mute_mic.set()
            self.set_vstate("idle", T("mic_muted"))
        self.show_mic_icons()

    def on_vspk_toggled(self, b):
        self.show_voice_icons()
        if self.speak_btn.get_active() != b.get_active():  # one switch for the chat and the voice mode
            self.speak_btn.set_active(b.get_active())

    def toggle_voice(self):
        if self.voice_on:
            self.voice_stop()
            return False
        self.voice_on = True
        self.vmic_btn.set_active(True)  # every voice session starts with both on
        self.speak_btn.set_active(True)
        self.voice_rev.show()
        self.overlay.set_overlay_pass_through(self.voice_rev, False)
        self.voice_rev.set_reveal_child(True)
        self.voice_orb.set_state("thinking")
        self.voice_state.set_text(T("voice_loading"))
        self.voice_text.set_text("")
        if self.voice is None:
            self.voice = core.Voice(self.cfg, self.ui)
        self.voice.cancel.clear()
        self.voice.hush.clear()
        self.voice.mute_mic.clear()
        self.voice_orb.level_fn = lambda: self.voice.level if self.voice and self.voice_orb.state in ("listening", "speaking") else None
        threading.Thread(target=self.voice_loop, daemon=True).start()
        self.show_mic_icons()
        return False

    def voice_stop(self):
        self.voice_on = False
        self.voice_rev.set_reveal_child(False)
        self.overlay.set_overlay_pass_through(self.voice_rev, True)
        GLib.timeout_add(450, lambda: (self.voice_rev.hide() if not self.voice_on else None) and False)
        self.input.grab_focus()
        if self.voice:
            self.voice.cancel.set()
            self.voice.stop_playing()
            self.voice.mute_mic.clear()
        self.speak_q.put(None)
        self.show_mic_icons()

    def barge_in(self, stop_gen=True):
        if self.voice:
            self.voice.stop_playing()
        try:
            while True:
                self.speak_q.get_nowait()
        except queue.Empty:
            pass
        if stop_gen:
            self.engine.stop.set()

    def set_vstate(self, st, text=None):
        self.voice_orb.set_state(st)
        self.voice_state.set_text({"listening": T("listening"), "thinking": T("thinking"), "speaking": T("speaking")}.get(st, "") if text is None else text)
        return False

    def feed_speech(self, text, final):
        if not (self.cfg["tts"] if self.voice_on else self.cfg["auto_speak"]):
            return
        if not self.voice_on:
            self.ensure_speaker()
        vis = core.speakable(text)
        if not final and any(s[0] == "think" and not s[2] for s in parse_segments(text)):
            return
        cut = len(vis) if final else core.sentence_cut(vis[self.spoken_upto:]) + self.spoken_upto
        if cut > self.spoken_upto:
            piece = vis[self.spoken_upto:cut].strip()
            self.spoken_upto = cut
            if piece:
                self.speak_q.put(piece)

    def show_speak_icon(self):
        on = self.speak_btn.get_active()
        self.speak_btn.set_image(Gtk.Image.new_from_icon_name("audio-volume-high-symbolic" if on else "audio-volume-muted-symbolic",
                                                              Gtk.IconSize.LARGE_TOOLBAR))
        self.speak_btn.show_all()

    def on_speak_toggled(self, b):
        on = b.get_active()
        self.show_speak_icon()
        self.cfg.set("auto_speak", on)
        self.toast(T("speak_on" if on else "speak_off"))
        if on:
            threading.Thread(target=self.warm_speaker, daemon=True).start()

    def warm_speaker(self):
        """Prepares the voice as soon as the speaker button is switched on, so the first answer is read without waiting."""
        try:
            if self.voice is None:
                self.voice = core.Voice(self.cfg, self.ui)
            self.voice.cancel.clear()
            self.voice.start(stt=False)
            if self.voice.output_silent():
                self.voice.warn_once("sink_muted")
        except core.Cancelled:
            pass
        except Exception as e:  # noqa: BLE001
            core.log(f"speaker warm-up: {e!r}")
            GLib.idle_add(self.toast, f"{T('error')}: {str(e)[:140]}")
        finally:
            self.ui.progress_done()

    def ensure_speaker(self):
        """Outside the voice mode a little thread reads the queued sentences aloud."""
        if getattr(self, "_speaker", None) and self._speaker.is_alive():
            return
        self._speaker = threading.Thread(target=self._speaker_loop, daemon=True)
        self._speaker.start()

    def _speaker_loop(self):
        try:
            if self.voice is None:
                self.voice = core.Voice(self.cfg, self.ui)
            self.voice.cancel.clear()
            self.voice.start(stt=False)
            while True:
                if self.voice_on:  # the voice mode owns the queue while it is on
                    return
                try:
                    piece = self.speak_q.get(timeout=0.5)
                except queue.Empty:
                    if not self.busy and not self.cfg["auto_speak"]:
                        return
                    continue
                if piece:
                    self.voice.speak(piece)
        except core.Cancelled:
            pass
        except Exception as e:  # noqa: BLE001
            core.log(f"speaker: {e!r}")
            GLib.idle_add(self.toast, f"{T('error')}: {str(e)[:140]}")
        finally:
            self.ui.progress_done()

    def voice_loop(self):
        v = self.voice
        try:
            v.start()
            while self.voice_on and not v.cancel.is_set():
                if v.mute_mic.is_set():
                    time.sleep(0.15)
                    continue
                GLib.idle_add(self.set_vstate, "listening")
                wav = v.listen()
                if not wav:
                    continue
                GLib.idle_add(self.set_vstate, "thinking")
                text = v.transcribe(wav)
                if len(text.strip()) < 2:
                    continue
                while self.busy:
                    time.sleep(0.1)
                try:
                    while True:
                        self.speak_q.get_nowait()
                except queue.Empty:
                    pass
                GLib.idle_add(self.voice_text.set_text, text)
                GLib.idle_add(self.send, text, True)
                time.sleep(0.3)
                while self.voice_on and not v.cancel.is_set():
                    try:
                        piece = self.speak_q.get(timeout=0.2)
                    except queue.Empty:
                        if self.gen_done.is_set() and self.speak_q.empty():
                            break
                        continue
                    if piece is None:
                        break
                    GLib.idle_add(self.set_vstate, "speaking")
                    v.speak(piece)
                    GLib.idle_add(self.set_vstate, "thinking" if self.busy else "listening")
        except core.Cancelled:
            pass
        except Exception as e:  # noqa: BLE001
            core.log(f"voice: {e!r}")
            GLib.idle_add(self.toast, f"{T('error')}: {str(e)[:140]}")
            GLib.idle_add(self.voice_stop)
        finally:
            self.ui.progress_done()

    # ----- the dial talks to us here
    def listen_socket(self):
        try:
            os.remove(SOCK)
        except OSError:
            pass
        self.srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.srv.bind(SOCK)
        self.srv.listen(4)
        self.srv.setblocking(False)
        GLib.io_add_watch(self.srv.fileno(), GLib.IO_IN, self.on_conn)

    def on_conn(self, fd, cond):
        try:
            conn, _ = self.srv.accept()
            conn.settimeout(0.3)
            data = conn.recv(256).decode(errors="ignore")
            conn.sendall(b"ok\n")
            conn.close()
        except OSError:
            return True
        for line in data.splitlines():
            cmd, _, arg = line.strip().partition(" ")
            if cmd == "open":
                self.set_model(arg, quiet=False, present=True, ask=True)
            elif cmd == "model":
                self.set_model(arg)
            elif cmd == "voice":
                self.win.present()
                if not self.voice_on:
                    self.toggle_voice()
        return True


def send_to_running(cmd):
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(1.0)
        s.connect(SOCK)
        s.sendall((cmd + "\n").encode())
        s.recv(8)
        s.close()
        return True
    except OSError:
        return False


def main():
    import argparse

    p = argparse.ArgumentParser(description="ASUS Dial AI chat app")
    p.add_argument("--model", default="", help="low | mid | high | max | custom")
    p.add_argument("--voice", action="store_true", help="start in voice mode")
    p.add_argument("--screenshot", default="", help="save a picture of the window and quit (for testing)")
    args = p.parse_args()
    if not args.screenshot:
        cmd = ("open " + args.model) if args.model else "open " + core.Config().data["model"]
        if send_to_running(cmd):  # already open: just bring it forward
            if args.voice:
                send_to_running("voice")
            return
    App(args)
    Gtk.main()


if __name__ == "__main__":
    main()
