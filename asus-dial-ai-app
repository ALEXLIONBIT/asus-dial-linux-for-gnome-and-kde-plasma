def md_to_pango(t):
    import re

    t = GLib.markup_escape_text(t)
    t = re.sub(r"(?m)^#{1,6}\s+(.+)$", r"<b><big>\1</big></b>", t)
    t = re.sub(r"\*\*(.+?)\*\*", r"<b>\1</b>", t)
    t = re.sub(r"(?<![\*\w])\*(?!\s)([^*\n]+?)(?<!\s)\*(?![\*\w])", r"<i>\1</i>", t)
    t = re.sub(r"`([^`\n]+)`", r'<span font_family="monospace" background="#80808040"> \1 </span>', t)
    t = re.sub(r"(?m)^(\s*)[-*]\s+", r"\1• ", t)
    return t


