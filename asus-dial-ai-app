            row.pack_start(col, False, False, 0)
        self.show_all()
        self.set_text(text, streaming)
        self.set_reveal_child(False)
        GLib.idle_add(lambda: self.set_reveal_child(True) and False)

    def visible_text(self):
        return "".join(p[1] for p in parse_segments(self.text) if p[0] != "think")

    def set_text(self, text, streaming=False):
        self.text = text
        if self.role == "user":
            segs = [("text", text, True)]
        else:
            segs = parse_segments(text)
            if not self.app.cfg["show_thinking"]:
                segs = [s for s in segs if s[0] != "think"]
        if self.avatar is not None:
            self.avatar.set_state(("speaking" if text else "thinking") if streaming else "idle")
        kinds = [s[0] for s in segs]
        want_dots = streaming and not any(s[1].strip() for s in segs if s[0] != "think")
        if kinds != self.kinds:
            for w in self.content.get_children():
                self.content.remove(w)
            self.widgets, self.labels, self.kinds, self.dots = [], [], kinds, None
            for s in segs:
                w = self.make(s)
                self.widgets.append(w)
                self.content.pack_start(w if not isinstance(w, tuple) else w[0], False, False, 0)
        for s, w in zip(segs, self.widgets):
            self.fill(s, w)
        if want_dots and self.dots is None:
            self.dots = Dots(self.app)
            self.dots.set_halign(Gtk.Align.START)
            self.content.pack_start(self.dots, False, False, 0)
        elif not want_dots and self.dots is not None:
            self.content.remove(self.dots)
            self.dots = None
        self.content.show_all()
        self.app.fit_labels(self)

    def make(self, seg):
        kind = seg[0]
        if kind == "code":
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            box.get_style_context().add_class("code-block")
            head = Gtk.Box()
            lang = Gtk.Label(xalign=0)
            lang.get_style_context().add_class("code-lang")
            head.pack_start(lang, True, True, 0)
            b = Gtk.Button(label=T("copy"))
            b.get_style_context().add_class("tiny")
            head.pack_end(b, False, False, 0)
            lab = Gtk.Label(xalign=0, selectable=True)
            lab.set_line_wrap(True)
            lab.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
            box.pack_start(head, False, False, 0)
            box.pack_start(lab, False, False, 0)
            box.lab, box.langlab, box.btn = lab, lang, b
            b.connect("clicked", lambda *_: copy_text(lab.get_text()))
            self.labels.append(lab)
            return box
        if kind == "think":
            ex = Gtk.Expander(label=T("thought"))
            lab = Gtk.Label(xalign=0, selectable=True)
            lab.get_style_context().add_class("think")
            lab.set_line_wrap(True)
            lab.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
            ex.add(lab)
            ex.lab, ex.closed_once = lab, False
            ex.set_expanded(True)
            self.labels.append(lab)
            return ex
        lab = Gtk.Label(xalign=0, selectable=True)
        lab.set_line_wrap(True)
        lab.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
        lab.set_halign(Gtk.Align.START)
        self.labels.append(lab)
        return lab

    def fill(self, seg, w):
        kind = seg[0]
        if kind == "code":
            w.lab.set_text(seg[1])
            w.langlab.set_text(seg[3] if len(seg) > 3 else "")
        elif kind == "think":
            w.lab.set_text(seg[1].strip())
            if seg[2] and not w.closed_once:
                w.closed_once = True
                w.set_expanded(False)
        else:
            if self.role == "user":
                w.set_text(seg[1])
            else:
                w.set_markup(md_to_pango(seg[1]))


# ------------------------------------------------------------------------------------------------ UI bridge (any thread -> GTK)
class UiBridge:
    def __init__(self, app):
        self.app = app
        self.lock = threading.Lock()
        self.pending = None
        self.scheduled = False

    def confirm(self, title, text, yes):
        ev, res = threading.Event(), [False]
        GLib.idle_add(self.app.show_confirm, title, text, yes, res, ev)
        ev.wait()
        return res[0]

    def progress(self, text, frac=None, line=None):
        with self.lock:
            p = self.pending or {"text": None, "frac": None, "lines": []}
            if text is not None:
                p["text"], p["frac"] = text, frac
            if line:
                p["lines"].append(line)
            self.pending = p
            if self.scheduled:
                return
            self.scheduled = True
        GLib.timeout_add(120, self._flush)

    def _flush(self):
        with self.lock:
            p, self.pending, self.scheduled = self.pending, None, False
        if p:
            self.app.banner_update(p["text"], p["frac"], p["lines"])
        return False

    def notice(self, text):
        GLib.idle_add(self.app.toast, text)

    def progress_done(self):
        with self.lock:
            self.pending = None
        GLib.idle_add(self.app.banner_hide)

    def note(self, text):
        GLib.idle_add(self.app.toast, text)


