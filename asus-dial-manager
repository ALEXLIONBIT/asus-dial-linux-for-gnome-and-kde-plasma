    # ---------------------------------------------------------------- data <-> list
    def mode_info(self, mode_id):
        """(icon, name, type text) of a mode id."""
        if mode_id.startswith("custom:"):
            c = next(c for c in self.cfg["custom"] if c["id"] == mode_id[7:])
            return c["icon"], c["name"], self.tr("custom")
        n = acfg.BUILTIN_IDS.index(mode_id)
        kind = "builtin_browser" if mode_id in acfg.BROWSER_ONLY_IDS else "builtin"
        return acfg.ICONS[n], acfg.NAMES_L[self.lang][n], self.tr(kind)

    def refresh(self, select_id=None):
        self.store.clear()
        for mode_id, enabled in acfg.all_modes(self.cfg):
            icon, name, kind = self.mode_info(mode_id)
            self.store.append([enabled, icon, name, kind, mode_id])
        if select_id:
            for row in self.store:
                if row[4] == select_id:
                    self.view.get_selection().select_iter(row.iter)
                    self.view.scroll_to_cell(row.path)
        self.update_buttons()

    def selected(self):
        model, it = self.view.get_selection().get_selected()
        return (model[it][4], model.get_path(it).get_indices()[0]) if it else (None, None)

    def update_buttons(self):
        if not hasattr(self, "btn"):
            return
        mode_id, pos = self.selected()
        custom = bool(mode_id and mode_id.startswith("custom:"))
        n = len(self.store)
        self.btn["up"].set_sensitive(pos is not None and pos > 0)
        self.btn["down"].set_sensitive(pos is not None and pos < n - 1)
        self.btn["edit"].set_sensitive(custom)
        self.btn["delete"].set_sensitive(custom)

    def on_sensitivity(self, scale):
        self.cfg["sensitivity"] = round(scale.get_value(), 2)
        if getattr(self, "_sens_save", 0):
            GLib.source_remove(self._sens_save)
        self._sens_save = GLib.timeout_add(300, lambda: (self.save(), setattr(self, "_sens_save", 0)) and False)  # one write once the slider rests

    def save(self):
        acfg.save(self.cfg)

    def full_order(self):
        return [m for m, _ in acfg.all_modes(self.cfg)]

    # ---------------------------------------------------------------- actions
    def on_toggled(self, _cell, path):
        row = self.store[path]
        disabled = set(self.cfg["modes"].get("disabled", []))
        if row[0]:
            if len(self.store) - len(disabled) <= 1:
                self.message(self.tr("need_one"))
                return
            disabled.add(row[4])
        else:
            disabled.discard(row[4])
        self.cfg["modes"]["disabled"] = sorted(disabled)
        self.save()
        row[0] = not row[0]

    def move(self, delta):
        mode_id, pos = self.selected()
        order = self.full_order()
        j = pos + delta
        if mode_id is None or not 0 <= j < len(order):
            return
        order[pos], order[j] = order[j], order[pos]
        self.cfg["modes"]["order"] = order
        self.save()
        self.refresh(mode_id)

    def edit_dialog(self, mode=None):
        dlg = EditDialog(self, self.tr, mode)
        resp = dlg.run()
        res = dlg.result(mode) if resp == Gtk.ResponseType.OK else None
        dlg.destroy()
        return res

    def on_add(self):
        res = self.edit_dialog()
        if not res:
            return
        res["id"] = acfg.slug(res["name"], {c["id"] for c in self.cfg["custom"]})
        self.cfg["custom"].append(res)
        self.cfg["modes"]["order"] = self.full_order()
        self.save()
        self.refresh("custom:" + res["id"])

    def on_edit(self):
        mode_id, _ = self.selected()
        if not mode_id or not mode_id.startswith("custom:"):
            return
        old = next(c for c in self.cfg["custom"] if c["id"] == mode_id[7:])
        res = self.edit_dialog(old)
        if res:
            old.update({k: res[k] for k in ("name", "icon", "click", "cw", "ccw")})
            self.save()
            self.refresh(mode_id)

    def on_delete(self):
        mode_id, _ = self.selected()
        if not mode_id or not mode_id.startswith("custom:"):
            return
        name = self.mode_info(mode_id)[1]
        if not self.confirm(self.tr("confirm_delete").format(name=name)):
            return
        self.cfg["custom"] = [c for c in self.cfg["custom"] if c["id"] != mode_id[7:]]
        for key in ("order", "disabled"):
            self.cfg["modes"][key] = [m for m in self.cfg["modes"].get(key, []) if m != mode_id]
        self.save()
        self.refresh()

    def on_restore(self):
        if not self.confirm(self.tr("confirm_restore")):
            return
        self.cfg["modes"]["disabled"] = []
        self.cfg["modes"]["order"] = list(acfg.DEFAULT_ORDER) + ["custom:" + c["id"] for c in self.cfg["custom"]]
        self.save()
        self.refresh()

    def on_lang(self, combo):
        lang = combo.get_active_id()
        if lang and lang != self.lang:
            self.lang = lang
            try:
                os.makedirs(os.path.dirname(acfg.LANG_FILE), exist_ok=True)
                with open(acfg.LANG_FILE, "w") as f:
                    f.write(lang)
            except OSError:
                pass
            GLib.idle_add(self.build)  # rebuild after the combo has finished handling the click

    # ---------------------------------------------------------------- small dialogs
    def message(self, text):
        d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.INFO,
                              buttons=Gtk.ButtonsType.OK, text=text)
        d.run()
        d.destroy()

    def confirm(self, text):
        d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                              buttons=Gtk.ButtonsType.OK_CANCEL, text=text)
        ok = d.run() == Gtk.ResponseType.OK
        d.destroy()
        return ok


