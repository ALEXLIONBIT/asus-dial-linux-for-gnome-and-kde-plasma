    def on_choose_character(self):
        dlg = Gtk.FileChooserDialog(title=self.tr("ch_choose"), transient_for=self, action=Gtk.FileChooserAction.OPEN)
        dlg.add_buttons(self.tr("cancel"), Gtk.ResponseType.CANCEL, self.tr("save"), Gtk.ResponseType.OK)
        flt = Gtk.FileFilter()
        flt.set_name(self.tr("images"))
        flt.add_pixbuf_formats()
        dlg.add_filter(flt)
        path = dlg.get_filename() if dlg.run() == Gtk.ResponseType.OK else None
        dlg.destroy()
        if not path:
            return
        try:
            pb = GdkPixbuf.Pixbuf.new_from_file(path)
            pb = pb.apply_embedded_orientation() or pb
            if pb.get_height() > 900:  # keep it a sensible size
                pb = pb.scale_simple(max(1, pb.get_width() * 900 // pb.get_height()), 900, GdkPixbuf.InterpType.BILINEAR)
        except GLib.Error:
            self.message(self.tr("bad_image"))
            return
