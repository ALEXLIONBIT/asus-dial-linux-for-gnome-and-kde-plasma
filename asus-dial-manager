    def on_choose_image(self):
        dlg = Gtk.FileChooserDialog(title=self.tr("choose_image"), transient_for=self, action=Gtk.FileChooserAction.OPEN)
        dlg.add_buttons(self.tr("cancel"), Gtk.ResponseType.CANCEL, self.tr("save"), Gtk.ResponseType.OK)
        flt = Gtk.FileFilter()
        flt.set_name(self.tr("images"))
        flt.add_pixbuf_formats()
        dlg.add_filter(flt)
        path = dlg.get_filename() if dlg.run() == Gtk.ResponseType.OK else None
        dlg.destroy()
        if not path:
            return
        try:
            pixbuf = GdkPixbuf.Pixbuf.new_from_file(path)
        except GLib.Error:
            self.message(self.tr("bad_image"))
            return
        crop = CropDialog(self, self.tr, pixbuf)
        if crop.run() == Gtk.ResponseType.OK:
            os.makedirs(acfg.CONFIG_DIR, exist_ok=True)
            for old in os.listdir(acfg.CONFIG_DIR):
                if old.startswith("background-") and old.endswith(".png"):
                    os.remove(os.path.join(acfg.CONFIG_DIR, old))
            out = os.path.join(acfg.CONFIG_DIR, f"background-{int(time.time())}.png")  # new name = the driver reloads it
            crop.save_png(out)
            self.theme["bg_image"] = out
            self.theme["bg_type"] = "image"
            self.cfg["theme"] = dict(self.theme)
            self.save()
            self.load_look_widgets()
        crop.destroy()

    # previews
    def preview_items(self):
        out = []
