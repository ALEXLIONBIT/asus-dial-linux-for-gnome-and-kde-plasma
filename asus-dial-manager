def read_lang():
    try:
        with open(acfg.LANG_FILE) as f:
            lang = f.read().strip()
        return lang if lang in LI else "en"
    except OSError:
        return "en"


class EditDialog(Gtk.Dialog):
    """Create or edit a custom mode: name, icon and three key sequences, with a key recorder."""

    ACTIONS = (("click", "act_click"), ("cw", "act_cw"), ("ccw", "act_ccw"))

    def __init__(self, parent, tr, mode=None):
        super().__init__(title=tr("dlg_edit" if mode else "dlg_new"), transient_for=parent, modal=True)
        self.tr = tr
        self.recording = None  # (entry, button)
        self.set_default_size(560, -1)
        box = self.get_content_area()
        box.set_spacing(10)
        box.set_border_width(14)
        grid = Gtk.Grid(row_spacing=8, column_spacing=10)
        box.pack_start(grid, False, False, 0)

        grid.attach(Gtk.Label(label=tr("name"), xalign=0), 0, 0, 1, 1)
        self.name = Gtk.Entry(text=mode["name"] if mode else "", hexpand=True)
        grid.attach(self.name, 1, 0, 2, 1)
        grid.attach(Gtk.Label(label=tr("icon"), xalign=0), 0, 1, 1, 1)
        self.icon = Gtk.Entry(text=mode["icon"] if mode else "⌨", max_length=4, width_chars=5, halign=Gtk.Align.START)
        grid.attach(self.icon, 1, 1, 2, 1)

        hint = Gtk.Label(label=tr("keys_hint"), xalign=0, wrap=True)
        hint.get_style_context().add_class("dim-label")
        grid.attach(hint, 0, 2, 3, 1)
        self.entries, self.buttons = {}, {}
        for row, (key, label) in enumerate(self.ACTIONS, start=3):
            grid.attach(Gtk.Label(label=tr(label), xalign=0), 0, row, 1, 1)
            entry = Gtk.Entry(text=mode[key] if mode else "", hexpand=True)
            entry.connect("changed", lambda *_: self.validate())
            grid.attach(entry, 1, row, 1, 1)
            btn = Gtk.ToggleButton(label=tr("record"))
            btn.connect("toggled", self.on_record_toggled, key)
            grid.attach(btn, 2, row, 1, 1)
            self.entries[key], self.buttons[key] = entry, btn
        self.rec_hint = Gtk.Label(label="", xalign=0, wrap=True)
        grid.attach(self.rec_hint, 0, 6, 3, 1)
        self.error = Gtk.Label(label="", xalign=0, wrap=True)
        self.error.get_style_context().add_class("error")
        grid.attach(self.error, 0, 7, 3, 1)
        self.name.connect("changed", lambda *_: self.validate())

        self.add_button(tr("cancel"), Gtk.ResponseType.CANCEL)
        self.ok = self.add_button(tr("save"), Gtk.ResponseType.OK)
        self.ok.get_style_context().add_class("suggested-action")
        self.connect("key-press-event", self.on_key)
        self.show_all()
        self.validate()

    def validate(self):
        msg = ""
        if not self.name.get_text().strip():
            msg = self.tr("need_name")
        else:
            any_action = False
            for key, label in self.ACTIONS:
                text = self.entries[key].get_text()
                try:
                    any_action = bool(acfg.parse_sequence(text)) or any_action
                except ValueError as e:
                    msg = self.tr("bad_keys").format(field=self.tr(label), err=e)
                    break
            else:
                if not any_action:
                    msg = self.tr("need_action")
        self.error.set_text(msg)
        self.ok.set_sensitive(not msg)

    def on_record_toggled(self, btn, key):
        if btn.get_active():
            if self.recording and self.recording[1] is not btn:
                self.recording[1].set_active(False)
            self.recording = (self.entries[key], btn)
            btn.set_label(self.tr("stop"))
            self.rec_hint.set_text(self.tr("recording"))
            self.grab_focus()
        else:
            btn.set_label(self.tr("record"))
            if self.recording and self.recording[1] is btn:
                self.recording = None
                self.rec_hint.set_text("")

    def on_key(self, _w, event):
        if not self.recording:
            return False
        code = event.hardware_keycode - 8  # X11 keycode -> Linux key code
        if code in acfg.MOD_NAMES.values() or code not in acfg.CODE_NAMES:
            return True  # a modifier on its own or an unknown key: wait for the real key
        mods = [acfg.MOD_NAMES[name] for mask, name in MOD_MASKS if event.state & mask]
        entry = self.recording[0]
        text = (entry.get_text().strip() + " " + acfg.combo_text(mods, code)).strip()
        entry.set_text(text)
        return True

    def result(self, old=None):
        return {"id": old["id"] if old else None, "name": self.name.get_text().strip(),
                "icon": self.icon.get_text().strip() or "⌨",
                "click": self.entries["click"].get_text().strip(),
                "cw": self.entries["cw"].get_text().strip(), "ccw": self.entries["ccw"].get_text().strip()}


class CropDialog(Gtk.Dialog):
    """Pick a round area of an image: drag the circle, zoom with the slider."""

    def __init__(self, parent, tr, pixbuf):
        super().__init__(title=tr("crop_title"), transient_for=parent, modal=True)
        self.pixbuf = pixbuf.apply_embedded_orientation() or pixbuf
        self.iw, self.ih = self.pixbuf.get_width(), self.pixbuf.get_height()
        self.k = min(560 / self.iw, 420 / self.ih, 1.0)
        self.side = min(self.iw, self.ih)
        self.cx, self.cy = self.iw / 2, self.ih / 2
        box = self.get_content_area()
        box.set_spacing(8)
        box.set_border_width(12)
        hint = Gtk.Label(label=tr("crop_hint"), xalign=0)
        hint.get_style_context().add_class("dim-label")
        box.pack_start(hint, False, False, 0)
        self.view = Gtk.DrawingArea()
        self.view.set_size_request(int(self.iw * self.k), int(self.ih * self.k))
        self.view.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON1_MOTION_MASK | Gdk.EventMask.SCROLL_MASK)
        self.view.connect("draw", self.on_draw)
        self.view.connect("button-press-event", self.on_drag)
        self.view.connect("motion-notify-event", self.on_drag)
        self.view.connect("scroll-event", self.on_scroll)
        box.pack_start(self.view, True, True, 0)
        row = Gtk.Box(spacing=8)
        row.pack_start(Gtk.Label(label=tr("crop_zoom")), False, False, 0)
        self.zoom = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 15, 100, 1)
        self.zoom.set_value(100)
        self.zoom.set_draw_value(False)
        self.zoom.set_hexpand(True)
        self.zoom.connect("value-changed", self.on_zoom)
        row.pack_start(self.zoom, True, True, 0)
        box.pack_start(row, False, False, 0)
        self.add_button(tr("cancel"), Gtk.ResponseType.CANCEL)
        self.add_button(tr("save"), Gtk.ResponseType.OK).get_style_context().add_class("suggested-action")
        self.show_all()

    def clamp(self):
        half = self.side / 2
        self.cx = max(half, min(self.iw - half, self.cx))
        self.cy = max(half, min(self.ih - half, self.cy))

    def on_zoom(self, scale):
        self.side = max(8, min(self.iw, self.ih) * scale.get_value() / 100)
        self.clamp()
        self.view.queue_draw()

    def on_drag(self, _w, e):
        self.cx, self.cy = e.x / self.k, e.y / self.k
        self.clamp()
        self.view.queue_draw()
        return True

    def on_scroll(self, _w, e):
        self.zoom.set_value(self.zoom.get_value() + (-5 if e.direction == Gdk.ScrollDirection.UP else 5))
        return True

    def on_draw(self, _w, cr):
        cr.scale(self.k, self.k)
        Gdk.cairo_set_source_pixbuf(cr, self.pixbuf, 0, 0)
        cr.paint()
        cr.set_fill_rule(cairo.FILL_RULE_EVEN_ODD)  # darken everything outside the circle
        cr.rectangle(0, 0, self.iw, self.ih)
        cr.arc(self.cx, self.cy, self.side / 2, 0, 6.2832)
        cr.set_source_rgba(0, 0, 0, 0.6)
        cr.fill()
        cr.arc(self.cx, self.cy, self.side / 2, 0, 6.2832)
        cr.set_source_rgba(1, 1, 1, 0.9)
        cr.set_line_width(2 / self.k)
        cr.stroke()

    def save_png(self, path):
        side = int(self.side)
        x = int(max(0, min(self.iw - side, self.cx - side / 2)))
        y = int(max(0, min(self.ih - side, self.cy - side / 2)))
        crop = self.pixbuf.new_subpixbuf(x, y, side, side).scale_simple(600, 600, GdkPixbuf.InterpType.BILINEAR)
        crop.savev(path, "png", [], [])


class Manager(Gtk.Window):
    def __init__(self):
        super().__init__()
        self.set_default_size(1020, 680)
        self.set_wmclass("asus-dial-manager", "asus-dial-manager")
        self.lang = read_lang()
        self.cfg = acfg.load()
        self.root = None
        self.build()
        self.connect("destroy", Gtk.main_quit)

    def tr(self, key):
        return STR[key][LI[self.lang]]

    # ---------------------------------------------------------------- UI
    def build(self):
        for attr in ("tick_id", "wtick_id", "atick_id", "ptick_id"):
            if getattr(self, attr, 0):
                GLib.source_remove(getattr(self, attr))
                setattr(self, attr, 0)
        if self.root:
            self.remove(self.root)
        self.set_title(self.tr("title"))
        self.stack = Gtk.Stack()
        for name, key, builder in (("modes", "tab_modes", self.build_modes_tab), ("look", "tab_look", self.build_look_tab),
                                   ("anim", "tab_anim", self.build_anim_tab), ("general", "tab_general", self.build_general_tab),
                                   ("about", "tab_about", self.build_about_tab)):
            self.stack.add_titled(builder(), name, self.tr(key))
        switcher = Gtk.StackSwitcher(stack=self.stack, halign=Gtk.Align.CENTER, margin_top=8)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.pack_start(switcher, False, False, 0)
        box.pack_start(self.stack, True, True, 0)
        self.root = box
        self.add(box)
        self.apply_app_anim()
        self.show_all()
        self.update_buttons()

    def build_modes_tab(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, border_width=12)
        hint = Gtk.Label(label=self.tr("modes_hint"), xalign=0, wrap=True)
        hint.get_style_context().add_class("dim-label")
        page.pack_start(hint, False, False, 0)
        body = Gtk.Box(spacing=10)
