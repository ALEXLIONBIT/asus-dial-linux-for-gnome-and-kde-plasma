    # ---------------------------------------------------------------- animations
    TRANSITIONS = {"none": "NONE", "crossfade": "CROSSFADE", "slide": "SLIDE_LEFT_RIGHT", "slide-up": "SLIDE_UP_DOWN",
                   "over": "OVER_UP_DOWN", "under": "UNDER_UP_DOWN"}

    def anim(self):
        return acfg.animation_of(self.cfg)

    def apply_app_anim(self):
        an = self.anim()
        kind = an["app_type"] if an["app"] else "none"
        self.stack.set_transition_type(getattr(Gtk.StackTransitionType, self.TRANSITIONS[kind], Gtk.StackTransitionType.CROSSFADE))
        self.stack.set_transition_duration(an["app_ms"] if an["app"] else 0)

    def fade_in(self):
        """The window fades in when it opens (if the app animations are on)."""
        an = self.anim()
        if not an["app"] or an["app_ms"] <= 0:
            return
        self.set_opacity(0.0)
        t0 = time.monotonic()

        def step():
            u = min(1.0, (time.monotonic() - t0) / (an["app_ms"] / 1000))
            self.set_opacity(ath.ease("smooth", u))
            return u < 1.0

        GLib.timeout_add(16, step)

