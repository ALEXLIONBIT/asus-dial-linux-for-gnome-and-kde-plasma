    def color_button(self, theme_key):
        cb = Gtk.ColorButton()
        cb.connect("color-set", lambda c, k=theme_key: self.set_theme(k, self.rgba_hex(c.get_rgba())))
        return cb

    @staticmethod
    def rgba_hex(rgba):
        return "#%02x%02x%02x" % tuple(round(max(0, min(1, v)) * 255) for v in (rgba.red, rgba.green, rgba.blue))

    def load_look_widgets(self):
        """Put the current theme into the controls (without triggering their handlers)."""
        self._loading = True
        th = self.theme
        self.w["bg_type"].set_active_id(th["bg_type"])
        self.w["plasma_mode"].set_active_id(th["plasma_mode"])
        self.update_look_sensitivity()
        for key in ("bg_color", "accent", "text", "glow_color"):
            rgba = Gdk.RGBA()
            rgba.parse(th[key])
            self.w[key].set_rgba(rgba)
        for key in ("bg_opacity", "image_dim", "blur", "glow_strength", "reflection", "shadow_strength", "speed"):
            div = self.w[key + "_div"]
            self.w[key].set_value(th[key] * div if div != 1 else th[key])
        for key in ("glow", "shadow", "sparkles"):
            self.w[key].set_active(bool(th[key]))
        self.w["preset"].set_active(-1)
        name = os.path.basename(th["bg_image"]) if th["bg_image"] and os.path.exists(th["bg_image"]) else self.tr("no_image")
        self.w["image_name"].set_text(name)
        self._loading = False
        self.menu_area.queue_draw()
        self.osd_area.queue_draw()

    def update_look_sensitivity(self):
        """The Plasma background takes its colors from the desktop: its own controls on, the color ones off."""
        plasma = self.theme["bg_type"] == "plasma"
        self.w["plasma_mode"].set_sensitive(plasma)
        for key in ("bg_color", "accent", "text"):
            self.w[key].set_sensitive(not plasma)

    def set_theme(self, key, value):
        if self._loading:
            return
        self.theme[key] = value
        if key == "bg_type":
            self.update_look_sensitivity()
        self.backdrops.clear()
        self.cfg["theme"] = dict(self.theme)
        if self.save_id:
            GLib.source_remove(self.save_id)
        self.save_id = GLib.timeout_add(250, self.flush_theme)  # one write after the last tweak
        self.menu_area.queue_draw()
        self.osd_area.queue_draw()

    def flush_theme(self):
        self.save_id = 0
        self.save()
        return False

    def apply_theme(self, partial):
        image = self.theme.get("bg_image", "")
        self.theme = dict(acfg.DEFAULT_THEME, **partial)
        self.theme["bg_image"] = image
        self.cfg["theme"] = dict(self.theme)
        self.save()
        self.backdrops.clear()
        self.load_look_widgets()

    def on_preset(self, combo):
        pid = combo.get_active_id()
        if pid and not self._loading:
