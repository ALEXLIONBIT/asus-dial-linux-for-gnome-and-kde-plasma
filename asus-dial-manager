            out.append((icon, name))
        return out or [("↕", "Scroll")]

    def fake_backdrop(self, w, h):
        """Stripes of color, so the blur and transparency of the theme are visible in the preview."""
        s_ = cairo.ImageSurface(cairo.FORMAT_ARGB32, w, h)
        cr = cairo.Context(s_)
        g = cairo.LinearGradient(0, 0, w, h)
        g.add_color_stop_rgb(0, 0.95, 0.45, 0.2)
        g.add_color_stop_rgb(1, 0.1, 0.45, 0.9)
        cr.set_source(g)
        cr.paint()
        cols = ((0.9, 0.2, 0.3), (0.2, 0.7, 0.4), (0.95, 0.85, 0.2), (0.4, 0.3, 0.8), (0.1, 0.1, 0.12), (0.95, 0.95, 0.95))
        for i in range(12):
            cr.set_source_rgb(*cols[i % 6])
            cr.rectangle(i * w / 12, (i % 3) * h / 3, w / 12 * 0.8, h / 3)
            cr.fill()
        return s_

    def blurred(self, surf, radius):
        try:
            from PIL import Image, ImageFilter
            w, h = surf.get_width(), surf.get_height()
            im = Image.frombuffer("RGBA", (w, h), bytes(surf.get_data()), "raw", "BGRA", 0, 1).filter(ImageFilter.GaussianBlur(radius))
            data = bytearray(im.tobytes("raw", "BGRA"))
            return cairo.ImageSurface.create_for_data(data, cairo.FORMAT_ARGB32, w, h, w * 4)
        except Exception:
            return None

    def draw_preview(self, area, cr, W, H, pad):
        fake = self.backdrops.get(("bg", W, H))
        if fake is None:
            fake = self.fake_backdrop(W, H)
            self.backdrops[("bg", W, H)] = fake
        cr.set_source_surface(fake, 0, 0)
        cr.paint()
        bd = None
        if self.theme["blur"] > 0:
            key = ("blur", W, H, self.theme["blur"])
            if key not in self.backdrops:
                self.backdrops[key] = self.blurred(fake, self.theme["blur"])
            bd = self.backdrops[key]
        return bd

    def on_draw_menu(self, area, cr):
        th = self.theme
        pad = ath.menu_pad(th)
        ms = 560
        Wn = ms + 2 * pad
        k = min(area.get_allocated_width(), area.get_allocated_height()) / Wn
        cr.scale(k, k)
        bd = self.draw_preview(area, cr, Wn, Wn, pad)
        items = self.preview_items()
        t = time.monotonic() - self.t0
        ath.draw_menu(cr, th, items, int(t / 1.2) % len(items), t, ms, bd)

    def on_draw_osd(self, area, cr):
        th = self.theme
        pad = ath.osd_pad(th)
        Wn, Hn = ath.OSD_W + 2 * pad, ath.OSD_H + 2 * pad
        k = min(area.get_allocated_width() / Wn, area.get_allocated_height() / Hn, 1.0)
        cr.translate((area.get_allocated_width() - Wn * k) / 2, 0)
        cr.scale(k, k)
        bd = self.draw_preview(area, cr, Wn, Hn, pad)
        ath.draw_osd(cr, th, "🔊 Volume 62%", 0.62, time.monotonic() - self.t0, bd)

    def tick_preview(self):
        if not self.get_realized():
            return True
        sel = int((time.monotonic() - self.t0) / 1.2)
        if ath.is_animated(self.theme) or sel != self.last_sel:  # a static theme only needs a redraw when the highlight moves
            self.last_sel = sel
            self.menu_area.queue_draw()
            self.osd_area.queue_draw()
        return True

