    def set_anim(self, key, value):
        if getattr(self, "_aloading", True):
            return
        self.cfg.setdefault("animation", {})[key] = value
        if getattr(self, "save_id", 0):
            GLib.source_remove(self.save_id)
        self.save_id = GLib.timeout_add(250, self.flush_theme)
        self.pt0 = time.monotonic()  # restart the preview
        if key in ("app", "app_type", "app_ms"):
            self.apply_app_anim()

    def preview_phase(self):
        """-> (anim tuple or None, visible?, sel position) for the looping preview."""
        an = self.anim()
        t_in, t_out = an["in_ms"] / 1000, an["out_ms"] / 1000
        hold = 1.8
        total = t_in + hold + t_out + 0.5
        t = (time.monotonic() - self.pt0) % total
        items = max(2, len(self.preview_items()))
        if t < t_in and an["in_type"] != "none" and t_in > 0:
            return (an["in_type"], t / t_in, an["ease"]), True, 2.0
        t -= t_in
        if t < hold:
            u = (t - 0.5) / (an["highlight_ms"] / 1000 if an["highlight"] and an["highlight_ms"] else 0.001)
            pos = 2.0 if t < 0.5 else (ath.sel_interp(2, min(5, items - 1), items, u, an["ease"]) if u < 1 else float(min(5, items - 1)))
            return None, True, pos
        t -= hold
        if t < t_out and an["out_type"] != "none" and t_out > 0:
            return (an["out_type"], 1.0 - t / t_out, an["ease"]), True, float(min(5, items - 1))
        return None, False, 0.0

    def on_draw_anim_menu(self, area, cr):
        th = acfg.theme_of(self.cfg)
        pad = ath.menu_pad(th)
        ms = 560
        Wn = ms + 2 * pad
        k = min(area.get_allocated_width(), area.get_allocated_height()) / Wn
        cr.scale(k, k)
        bd = self.draw_preview(area, cr, Wn, Wn, pad)
        anim, visible, pos = self.preview_phase()
        if visible:
            items = self.preview_items()
            ath.draw_menu(cr, th, items, int(round(pos)) % len(items), time.monotonic() - self.pt0, ms, bd, sel_pos=pos, anim=anim)

    def on_draw_anim_osd(self, area, cr):
        th = acfg.theme_of(self.cfg)
        pad = ath.osd_pad(th)
        Wn, Hn = ath.OSD_W + 2 * pad, ath.OSD_H + 2 * pad
        k = min(area.get_allocated_width() / Wn, area.get_allocated_height() / Hn, 1.0)
        cr.translate((area.get_allocated_width() - Wn * k) / 2, 0)
        cr.scale(k, k)
        bd = self.draw_preview(area, cr, Wn, Hn, pad)
        anim, visible, _pos = self.preview_phase()
        if visible:
            ath.draw_osd(cr, th, "🔊 Volume 62%", 0.62, time.monotonic() - self.pt0, bd, anim=anim)

