    def slider(self, grid, row, label_key, theme_key, lo, hi, div, wkey=None):
        grid.attach(Gtk.Label(label=self.tr(label_key), xalign=0), 0, row[0], 1, 1)
        sc = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, lo, hi, 1)
        sc.set_draw_value(True)
        sc.set_value_pos(Gtk.PositionType.RIGHT)
        sc.set_hexpand(True)
        sc.connect("value-changed", lambda s_, k=theme_key, d=div: self.set_theme(k, s_.get_value() / d if d != 1 else int(s_.get_value())))
        grid.attach(sc, 1, row[0], 1, 1)
        self.w[wkey or theme_key] = sc
        self.w[(wkey or theme_key) + "_div"] = div
        row[0] += 1
        return sc

    def check(self, grid, row, label_key, theme_key):
        cb = Gtk.CheckButton(label=self.tr(label_key))
        cb.connect("toggled", lambda c, k=theme_key: self.set_theme(k, c.get_active()))
        grid.attach(cb, 0, row[0], 2, 1)
        row[0] += 1
